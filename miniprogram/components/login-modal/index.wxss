.login-modal {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  inset: 0;
  background: rgba(15, 23, 42, 0.58);
  backdrop-filter: blur(6rpx);
}

.modal-content {
  position: relative;
  width: 580rpx;
  padding: 54rpx 40rpx 40rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.2);
  animation: modalSlideIn 0.24s ease-out;
}

@keyframes modalSlideIn {
  from {
    transform: translateY(14rpx) scale(0.96);
    opacity: 0;
  }
  to {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
}

.modal-header {
  text-align: center;
}

.modal-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.modal-title {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #64748b;
}

.modal-body {
  margin-top: 40rpx;
}

.btn-wechat-login {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(34, 197, 94, 0.24);
}

.btn-wechat-login::after {
  border: none;
}

.btn-wechat-login.btn-hover {
  opacity: 0.92;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 700;
}
