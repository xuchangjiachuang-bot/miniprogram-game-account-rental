page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.error-card {
  margin: 24rpx 20rpx;
  padding: 42rpx 34rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.06);
  text-align: center;
}

.error-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.error-text {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #64748b;
}

.error-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.error-btn::after {
  border: none;
}

.hero-gallery {
  position: relative;
  height: 420rpx;
  background: #e2e8f0;
}

.account-swiper,
.swiper-image {
  width: 100%;
  height: 100%;
}

.gallery-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.04) 0%, rgba(15, 23, 42, 0.32) 100%);
  pointer-events: none;
}

.gallery-counter {
  position: absolute;
  top: 26rpx;
  right: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.58);
  color: #ffffff;
  font-size: 22rpx;
}

.swiper-indicators {
  position: absolute;
  left: 28rpx;
  bottom: 28rpx;
  display: flex;
  gap: 10rpx;
}

.indicator-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
}

.indicator-dot.active {
  width: 34rpx;
  background: #ffffff;
}

.swiper-btn {
  position: absolute;
  top: 50%;
  width: 68rpx;
  height: 68rpx;
  margin-top: -34rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.55);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.swiper-btn.prev {
  left: 20rpx;
}

.swiper-btn.next {
  right: 20rpx;
}

.content-shell {
  position: relative;
  z-index: 2;
  margin-top: -44rpx;
  padding: 0 20rpx 24rpx;
}

.headline-card,
.section-card,
.price-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.06);
}

.section-card,
.price-card {
  margin-top: 20rpx;
}

.headline-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.headline-copy {
  flex: 1;
  min-width: 0;
}

.account-title {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 800;
  color: #0f172a;
}

.account-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.account-status {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.account-status.available {
  color: #0f9f64;
  background: #e9fbf2;
}

.account-status.rented,
.account-status.renting {
  color: #b45309;
  background: #fff4df;
}

.account-status.locked,
.account-status.pending {
  color: #4f46e5;
  background: #eef2ff;
}

.account-status.deleted,
.account-status.off_shelf,
.account-status.archived {
  color: #64748b;
  background: #f1f5f9;
}

.platform-badge {
  display: inline-flex;
  margin-top: 20rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 700;
}

.info-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.info-card {
  padding: 22rpx;
  border-radius: 22rpx;
  min-height: 140rpx;
}

.info-card.coins {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.info-card.ratio {
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
}

.info-card.safebox {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
}

.info-card.level {
  background: linear-gradient(135deg, #ecfeff 0%, #cffafe 100%);
}

.info-label {
  font-size: 22rpx;
  color: #64748b;
}

.info-value {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.attribute-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.attribute-item {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.attr-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.attr-value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.skins-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.skin-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.desc-content {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 27rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}

.price-row + .price-row {
  border-top: 1rpx solid #eef2f7;
}

.price-label {
  font-size: 26rpx;
  color: #64748b;
}

.price-value {
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 700;
}

.price-row.total .price-label {
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 700;
}

.price-row.total .price-value {
  font-size: 42rpx;
  color: #4f46e5;
  font-weight: 800;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 32rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(16rpx);
}

.btn-side {
  width: 118rpx;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e2e8f0;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.btn-side::after,
.btn-rent::after {
  border: none;
}

.btn-side-main {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.btn-side-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.btn-rent {
  flex: 1;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 30rpx rgba(79, 70, 229, 0.26);
}

.btn-rent[disabled] {
  background: #cbd5e1;
  box-shadow: none;
}
