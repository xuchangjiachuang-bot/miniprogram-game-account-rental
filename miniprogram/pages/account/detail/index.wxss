page {
  min-height: 100vh;
  background: #f8fafc;
}

.page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.error-card {
  margin: calc(env(safe-area-inset-top) + 24rpx) 24rpx 24rpx;
  padding: 42rpx 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.05);
  text-align: center;
}

.error-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.error-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.error-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 26rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.error-btn::after,
.btn-side::after,
.btn-rent::after {
  border: none;
}

.hero-gallery {
  position: relative;
  margin: 0;
  padding-top: env(safe-area-inset-top);
  height: calc(360rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  border-radius: 0 0 26rpx 26rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.05);
}

.account-swiper,
.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-image {
  background: #f8fafc;
}

.gallery-counter {
  position: absolute;
  bottom: 18rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.68);
  color: #ffffff;
  font-size: 22rpx;
}

.swiper-btn {
  position: absolute;
  top: 50%;
  width: 64rpx;
  height: 64rpx;
  margin-top: -32rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.swiper-btn.prev { left: 18rpx; }
.swiper-btn.next { right: 18rpx; }

.content-shell {
  padding: 24rpx 24rpx 24rpx;
}

.headline-card,
.section-card {
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.05);
}

.headline-card {
  padding: 24rpx;
}

.section-card {
  margin-top: 18rpx;
  padding: 22rpx;
}

.account-title {
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #0f172a;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.summary-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.summary-pill.brand {
  background: #eff6ff;
  color: #2563eb;
}

.summary-pill.method {
  background: #f5f3ff;
  color: #7c3aed;
}

.summary-pill.region {
  background: #f8fafc;
  color: #475569;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.metric-card {
  padding: 18rpx;
  border-radius: 20rpx;
}

.metric-card.coins {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.metric-card.ratio {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
}

.metric-card.money,
.metric-card.duration {
  background: #f8fafc;
}

.metric-card.total {
  background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
}

.metric-card-label {
  display: block;
  font-size: 20rpx;
  color: #64748b;
}

.metric-card-value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #0f172a;
}

.metric-card-value.compact {
  font-size: 26rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.attribute-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.attribute-item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.attr-label {
  display: block;
  font-size: 20rpx;
  color: #64748b;
}

.attr-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #0f172a;
  word-break: break-all;
}

.skins-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.skin-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fdf2f8;
  color: #be185d;
  font-size: 20rpx;
  font-weight: 600;
}

.desc-content {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #475569;
  font-size: 24rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.btn-side,
.btn-rent {
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-side {
  width: 180rpx;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
  color: #334155;
}

.btn-rent {
  flex: 1;
  background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
}

.btn-rent[disabled] {
  background: #cbd5e1;
}
