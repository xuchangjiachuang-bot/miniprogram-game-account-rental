<!-- pages/account/publish/index.wxml -->
<view class="page">
  <form bindsubmit="onSubmit">
    <view class="section">
      <view class="section-title required">账号截图<text class="required-mark">*</text></view>
      <view class="uploader-wrapper">
        <view class="image-list">
          <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
            <image class="image" src="{{item}}" mode="aspectFill" bindtap="onImagePreview" data-url="{{item}}" />
            <view class="image-delete" bindtap="onImageDelete" data-index="{{index}}">×</view>
            <view class="image-cover" wx:if="{{index === 0}}">封面</view>
          </view>
          <view class="image-add" wx:if="{{form.images.length < 5}}" bindtap="onChooseImage">
            <text class="add-icon">+</text>
            <text class="add-text">添加图片</text>
          </view>
        </view>
      </view>
      <view class="section-tips">最多上传 5 张截图，第一张将作为封面展示。</view>
    </view>

    <view class="section">
      <view class="section-title">基础信息</view>

      <view class="form-item required">
        <text class="form-label">游戏账号<text class="required-mark">*</text></text>
        <input class="form-input" placeholder="请输入游戏账号" value="{{form.accountId}}" bindinput="onAccountIdInput" />
      </view>

      <view class="form-item required">
        <text class="form-label">游戏密码<text class="required-mark">*</text></text>
        <input class="form-input" password placeholder="请输入游戏密码" value="{{form.password}}" bindinput="onPasswordInput" />
      </view>

      <view class="form-item">
        <text class="form-label">验证码</text>
        <input class="form-input" placeholder="如果有验证码，请填写" value="{{form.verifyCode}}" bindinput="onVerifyCodeInput" />
      </view>

      <view class="form-item">
        <text class="form-label">登录方式</text>
        <picker range="{{loginMethodOptions}}" range-key="label" value="{{form.loginMethodIndex}}" bindchange="onLoginMethodChange">
          <view class="form-picker">
            <text class="picker-value">{{loginMethodOptions[form.loginMethodIndex].label}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>
    </view>

    <view class="section">
      <view class="section-title">游戏数据</view>

      <view class="form-item required">
        <text class="form-label">哈夫币数量（M）<text class="required-mark">*</text></text>
        <input class="form-input" type="digit" placeholder="例如 120" value="{{form.coinsM}}" bindinput="onCoinsMInput" />
      </view>

      <view class="form-item required">
        <text class="form-label">安全箱规格<text class="required-mark">*</text></text>
        <picker range="{{safeboxOptions}}" range-key="label" value="{{form.safeboxIndex}}" bindchange="onSafeboxChange">
          <view class="form-picker">
            <text class="picker-value">{{safeboxOptions[form.safeboxIndex].label}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-item required">
        <text class="form-label">体力等级<text class="required-mark">*</text></text>
        <picker range="{{levelOptions}}" value="{{form.staminaLevel}}" bindchange="onStaminaLevelChange">
          <view class="form-picker">
            <text class="picker-value">Lv.{{form.staminaLevel}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-item required">
        <text class="form-label">负重等级<text class="required-mark">*</text></text>
        <picker range="{{levelOptions}}" value="{{form.energyLevel}}" bindchange="onEnergyLevelChange">
          <view class="form-picker">
            <text class="picker-value">Lv.{{form.energyLevel}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">段位</text>
        <picker range="{{rankOptions}}" range-key="label" value="{{form.rankIndex}}" bindchange="onRankChange">
          <view class="form-picker">
            <text class="picker-value">{{rankOptions[form.rankIndex].label}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">KD 值</text>
        <input class="form-input" type="digit" placeholder="例如 2.5" value="{{form.kd}}" bindinput="onKdInput" />
      </view>
    </view>

    <view class="section">
      <view class="section-title">皮肤配置</view>

      <view class="form-item-switch">
        <text class="switch-label">是否有皮肤</text>
        <switch checked="{{form.hasSkins}}" bindchange="onHasSkinsChange" color="#2f6fed" />
      </view>

      <view class="form-item" wx:if="{{form.hasSkins}}">
        <text class="form-label">皮肤等级</text>
        <picker range="{{skinTierOptions}}" value="{{form.skinTierIndex}}" bindchange="onSkinTierChange">
          <view class="form-picker">
            <text class="picker-value">{{skinTierOptions[form.skinTierIndex]}}</text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{form.hasSkins}}">
        <text class="form-label">皮肤数量</text>
        <input class="form-input" type="number" placeholder="填写皮肤数量" value="{{form.skinCount}}" bindinput="onSkinCountInput" />
      </view>
    </view>

    <view class="section">
      <view class="section-title">战斗通行证</view>

      <view class="form-item-switch">
        <text class="switch-label">是否有战斗通行证</text>
        <switch checked="{{form.hasBattlepass}}" bindchange="onHasBattlepassChange" color="#2f6fed" />
      </view>

      <view class="form-item" wx:if="{{form.hasBattlepass}}">
        <text class="form-label">通行证等级</text>
        <input class="form-input" type="number" placeholder="例如 80" value="{{form.battlepassLevel}}" bindinput="onBattlepassLevelInput" />
      </view>
    </view>

    <view class="section">
      <view class="section-title">账号描述</view>
      <view class="form-item">
        <text class="form-label">详细描述</text>
        <textarea class="form-textarea" placeholder="补充账号亮点、常用装备、服装或特别说明" value="{{form.description}}" bindinput="onDescriptionInput" maxlength="500" autoHeight />
        <view class="char-count">{{form.description.length}}/500</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">租期设置</view>

      <view class="form-item required">
        <text class="form-label">出租比例（1 元对应多少万哈夫币）<text class="required-mark">*</text></text>
        <input class="form-input" type="digit" placeholder="建议 35-41" value="{{form.rentalRatio}}" bindinput="onRentalRatioInput" />
      </view>

      <view class="form-item required">
        <text class="form-label">租期自定义选项<text class="required-mark">*</text></text>
        <view class="speed-grid">
          <view
            class="speed-chip {{form.rentalSpeed === item ? 'active' : ''}}"
            wx:for="{{rentalSpeedOptions}}"
            wx:key="*this"
            bindtap="onRentalSpeedTap"
            data-speed="{{item}}"
          >
            {{item}}M/天
          </view>
        </view>
        <view class="helper-note">建议选择更快租期的同时，提高出租比例，请根据自己需求合理设置。</view>
      </view>

      <view class="form-item required">
        <text class="form-label">押金（元）<text class="required-mark">*</text></text>
        <input class="form-input" type="digit" placeholder="请输入押金金额" value="{{form.deposit}}" bindinput="onDepositInput" />
      </view>

      <view class="price-preview">
        <text class="preview-label">建议租金</text>
        <text class="preview-price">¥{{form.suggestedRental}}</text>
      </view>

      <view class="info-card">
        <view class="info-row">
          <text class="info-label">预计租期</text>
          <text class="info-value">{{form.rentalPeriodText}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">总价预览</text>
          <text class="info-value">¥{{form.totalPrice}}（租金 + 押金）</text>
        </view>
      </view>
    </view>

    <view class="submit-bar">
      <button class="btn-submit" form-type="submit" disabled="{{submitting}}">{{submitting ? '发布中...' : '立即发布'}}</button>
    </view>

    <view class="bottom-placeholder"></view>
  </form>
</view>
