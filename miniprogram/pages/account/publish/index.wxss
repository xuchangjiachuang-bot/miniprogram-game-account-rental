page {
  background: #f3f6fb;
  min-height: 100vh;
}

.page {
  padding-bottom: 180rpx;
}

.section {
  background: #ffffff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #10233d;
  margin-bottom: 24rpx;
}

.required-mark {
  color: #e11d48;
  margin-left: 4rpx;
}

.uploader-wrapper {
  margin-bottom: 16rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  overflow: hidden;
}

.image {
  width: 100%;
  height: 100%;
  background: #eef2f7;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(15, 23, 42, 0.75);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 30rpx;
}

.image-cover {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 12rpx;
  background: linear-gradient(90deg, #0f766e 0%, #155e75 100%);
  color: #ffffff;
  font-size: 20rpx;
  text-align: center;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #c7d2e3;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #f8fbff;
}

.add-icon {
  font-size: 56rpx;
  color: #2f6fed;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #5b6b83;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item-switch {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.form-label,
.switch-label {
  display: block;
  font-size: 28rpx;
  color: #24364d;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.switch-label {
  margin-bottom: 0;
}

.form-input,
.form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f8fc;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #10233d;
  box-sizing: border-box;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 28rpx;
  color: #10233d;
}

.picker-arrow {
  font-size: 30rpx;
  color: #94a3b8;
}

.form-textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 20rpx 24rpx;
  background: #f5f8fc;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #10233d;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.section-tips {
  font-size: 24rpx;
  color: #6b7c93;
  line-height: 1.6;
}

.speed-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.speed-chip {
  height: 76rpx;
  border-radius: 14rpx;
  border: 2rpx solid #dbe7f5;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fbff;
  color: #355070;
  font-size: 26rpx;
  font-weight: 600;
}

.speed-chip.active {
  background: linear-gradient(90deg, #0f766e 0%, #2563eb 100%);
  color: #ffffff;
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.22);
}

.helper-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.price-preview {
  display: flex;
  align-items: baseline;
  padding: 24rpx;
  margin-top: 10rpx;
  background: linear-gradient(135deg, rgba(15, 118, 110, 0.08) 0%, rgba(37, 99, 235, 0.08) 100%);
  border-radius: 16rpx;
  border: 2rpx solid rgba(37, 99, 235, 0.14);
}

.preview-label {
  font-size: 28rpx;
  color: #51637b;
  margin-right: 16rpx;
}

.preview-price {
  font-size: 50rpx;
  font-weight: 800;
  color: #155e75;
}

.info-card {
  margin-top: 18rpx;
  background: #f8fbff;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e6eef8;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #64748b;
}

.info-value {
  font-size: 26rpx;
  color: #10233d;
  text-align: right;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(16rpx);
  box-shadow: 0 -12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.btn-submit {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(90deg, #0f766e 0%, #2563eb 100%);
  color: #ffffff;
  border: none;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.btn-submit[disabled] {
  background: #cbd5e1;
}

.bottom-placeholder {
  height: 160rpx;
}
