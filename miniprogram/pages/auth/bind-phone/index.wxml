<!-- pages/auth/bind-phone/index.wxml -->
<view class="page">
  <view class="container">
    <view class="header">
      <view class="title">绑定手机号</view>
      <view class="subtitle">用于订单通知、提现提醒和客服协助，建议登录后立即完成绑定。</view>
    </view>

    <view class="form">
      <view class="input-card">
        <view class="input-label">手机号</view>
        <input class="phone-input" type="number" maxlength="11" placeholder="请输入常用手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>

      <button class="phone-btn {{loading ? 'disabled' : ''}}" bindtap="onSubmit" disabled="{{loading}}">
        {{loading ? '绑定中...' : '确认绑定'}}
      </button>

      <view class="skip-section">
        <text class="skip-text" bindtap="onSkip">暂时跳过</text>
      </view>
    </view>
  </view>
</view>
