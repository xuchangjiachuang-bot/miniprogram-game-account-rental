.page {
  min-height: 100vh;
  background: #f3f6fb;
}

.container {
  min-height: 100vh;
  padding: 100rpx 48rpx 80rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
}

.header {
  margin-bottom: 70rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #10233d;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.7;
}

.form {
  width: 100%;
}

.input-card {
  padding: 28rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.08);
}

.input-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 14rpx;
}

.phone-input {
  height: 88rpx;
  padding: 0 20rpx;
  background: #f5f8fc;
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #10233d;
}

.phone-btn {
  width: 100%;
  height: 96rpx;
  margin-top: 36rpx;
  background: linear-gradient(90deg, #0f766e 0%, #2563eb 100%);
  color: #ffffff;
  border: none;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 30rpx rgba(37, 99, 235, 0.2);
}

.phone-btn.disabled {
  opacity: 0.6;
}

.skip-section {
  margin-top: 32rpx;
  text-align: center;
}

.skip-text {
  font-size: 26rpx;
  color: #94a3b8;
}
