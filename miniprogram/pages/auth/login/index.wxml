<!-- pages/auth/login/index.wxml -->
<view class="page">
  <view class="login-container">
    <view class="logo-section">
      <view class="logo-icon">号</view>
      <view class="app-name">哈夫币租号</view>
      <view class="app-desc">担保交易、押金保护、订单可追踪。</view>
    </view>

    <view class="form-section">
      <view class="login-highlight">推荐使用微信快捷登录，登录后可继续绑定手机号。</view>

      <button class="btn-wechat" bindtap="onWechatLogin" loading="{{loading}}" disabled="{{loading}}">
        <text class="btn-icon">微</text>
        <text>{{loading ? '登录中...' : '微信快捷登录'}}</text>
      </button>

      <view class="agreement">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-label">
            <checkbox value="agreed" checked="{{agreed}}" color="#667eea" />
            <text>我已阅读并同意</text>
            <text class="link" bindtap="onAgreementTap">《用户协议》</text>
            <text>和</text>
            <text class="link" bindtap="onPrivacyTap">《隐私政策》</text>
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="tips">
      <view class="tip-item">安全登录</view>
      <view class="tip-item">担保交易</view>
      <view class="tip-item">客服协助</view>
    </view>
  </view>
</view>
