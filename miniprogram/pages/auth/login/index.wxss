page {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.login-container {
  min-height: 100vh;
  padding: 100rpx 40rpx 80rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.14);
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 14rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.82);
}

.form-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 40rpx rgba(31, 41, 55, 0.14);
}

.login-highlight {
  font-size: 26rpx;
  color: #5b6475;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.btn-wechat {
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  border: none;
  background: linear-gradient(90deg, #07c160 0%, #11a863 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.btn-icon {
  font-size: 34rpx;
}

.agreement {
  margin-top: 28rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.7;
}

.agreement-label checkbox {
  transform: scale(0.82);
  margin-right: 4rpx;
}

.link {
  color: #5b6cf0;
}

.tips {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.tip-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.14);
  color: #ffffff;
  font-size: 24rpx;
}
