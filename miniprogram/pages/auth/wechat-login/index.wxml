<view class="page">
  <view class="login-container">
    <view class="hero-section">
      <view class="hero-badge">微信授权登录</view>
      <view class="logo-icon">号</view>
      <view class="app-name">哈夫币租号</view>
      <view class="app-slogan">担保交易、押金保护、订单可追踪，登录后即可继续使用完整服务。</view>
    </view>

    <view class="login-card">
      <view class="form-title">使用微信继续登录</view>
      <view class="form-desc">推荐通过微信授权完成登录，首次登录后可继续绑定手机号并同步资料。</view>

      <button class="auth-btn" bindtap="onWechatLogin" loading="{{loading}}" disabled="{{loading}}">
        <text class="btn-icon">微</text>
        <text>{{loading ? '登录中...' : '微信快捷登录'}}</text>
      </button>

      <view class="agreement">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-label">
            <checkbox value="agreed" checked="{{agreed}}" color="#16a34a" />
            <text>我已阅读并同意</text>
            <text class="link" bindtap="onTapAgreement">《用户协议》</text>
            <text>和</text>
            <text class="link" bindtap="onTapPrivacy">《隐私政策》</text>
          </label>
        </checkbox-group>
      </view>
    </view>

    <view class="tips">
      <view class="tip-item">微信快速授权</view>
      <view class="tip-item">账号资料同步</view>
      <view class="tip-item">客服可追踪协助</view>
    </view>

    <view class="back-link" bindtap="onBack">暂不登录，先返回</view>
  </view>
</view>
