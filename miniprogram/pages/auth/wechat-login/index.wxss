page {
  min-height: 100vh;
  background: linear-gradient(180deg, #ecfdf5 0%, #f8fafc 48%, #ffffff 100%);
}

.login-container {
  min-height: 100vh;
  padding: 88rpx 40rpx 60rpx;
}

.hero-section {
  text-align: center;
  margin-bottom: 52rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.logo-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 26rpx auto 22rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 30rpx rgba(34, 197, 94, 0.22);
}

.app-name {
  font-size: 46rpx;
  font-weight: 700;
  color: #0f172a;
}

.app-slogan {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #64748b;
}

.login-card {
  background: #ffffff;
  border-radius: 30rpx;
  padding: 42rpx 36rpx;
  box-shadow: 0 22rpx 44rpx rgba(15, 23, 42, 0.08);
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
}

.form-desc {
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #64748b;
  text-align: center;
}

.auth-btn {
  width: 100%;
  height: 96rpx;
  margin-top: 34rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 16rpx 28rpx rgba(34, 197, 94, 0.24);
}

.auth-btn::after {
  border: none;
}

.btn-icon {
  font-size: 34rpx;
}

.agreement {
  margin-top: 28rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
}

.agreement-label checkbox {
  transform: scale(0.82);
  margin-right: 4rpx;
}

.link {
  color: #16a34a;
}

.tips {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.tip-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #166534;
  font-size: 22rpx;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.05);
}

.back-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 25rpx;
  color: #64748b;
}
