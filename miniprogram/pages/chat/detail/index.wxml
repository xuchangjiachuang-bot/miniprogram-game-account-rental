<!-- pages/chat/detail/index.wxml -->
<view class="page">
  <view class="header">
    <view class="header-info">
      <image class="avatar" src="{{group.avatar}}" mode="aspectFill" />
      <view class="info">
        <view class="name">{{group.name}}</view>
        <view class="members">{{group.memberText}}</view>
      </view>
    </view>
    <view class="header-actions">
      <view class="action-item" bindtap="onViewOrder" wx:if="{{order}}">
        <text>订单</text>
      </view>
      <view class="action-item" bindtap="onViewMembers">
        <text>成员</text>
      </view>
    </view>
  </view>

  <scroll-view class="message-list" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation>
    <view class="message-item" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <view class="message-time" wx:if="{{item.showTime}}">
        <text>{{item.timeText}}</text>
      </view>

      <view class="message-system" wx:if="{{item.type === 'system'}}">
        <text>{{item.content}}</text>
      </view>

      <view class="message-content {{item.isSelf ? 'message-self' : 'message-other'}}" wx:if="{{item.type !== 'system'}}">
        <image class="message-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view class="message-body">
          <view class="message-name" wx:if="{{!item.isSelf}}">{{item.senderName}}</view>
          <view class="message-bubble">{{item.type === 'image' ? '[图片消息]' : item.content}}</view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{loadingMore}}">
      <text>加载中...</text>
    </view>
  </scroll-view>

  <view class="input-bar">
    <view class="input-wrapper">
      <input
        class="input-field"
        placeholder="输入消息..."
        value="{{inputText}}"
        bindinput="onInputInput"
        bindconfirm="onSend"
        confirm-type="send"
      />
      <view class="btn-actions">
        <button class="btn-send" bindtap="onSend" disabled="{{!inputText}}">发送</button>
      </view>
    </view>
  </view>
</view>
