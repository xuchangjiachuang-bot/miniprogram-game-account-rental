/* pages/chat/list/index.wxss */
.page {
  min-height: 100vh;
  background: #f6f8fc;
}

.search-bar {
  padding: 20rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eef2f7;
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f5f7fb;
  border-radius: 100rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

.chat-list {
  min-height: calc(100vh - 120rpx);
}

.chat-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f1f5f9;
}

.chat-avatar {
  position: relative;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}

.unread-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  background: #ff4757;
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
  border: 4rpx solid #ffffff;
}

.chat-content {
  flex: 1;
  min-width: 0;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.chat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-time {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.chat-message {
  font-size: 26rpx;
  color: #64748b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-tag {
  padding: 8rpx 16rpx;
  background: #eef2ff;
  color: #4f46e5;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #94a3b8;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-text {
  font-size: 32rpx;
  color: #1e293b;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.empty-hint {
  font-size: 26rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin: 24rpx;
  padding: 90rpx 40rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
}

.state-card.error {
  background: #fff8f8;
}

.state-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #dbe4f0;
  border-top-color: #4f46e5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.state-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.state-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.state-hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
  text-align: center;
}

.state-action {
  margin-top: 8rpx;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
}

.inline-error-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
}

.inline-error-action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.tabbar-placeholder {
  height: 100rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
