<!-- pages/index/index.wxml -->
<view class="page">
  <view class="hero-section">
    <view class="hero-container">
      <swiper wx:if="{{carousels.length > 0}}" class="carousel" indicator-dots autoplay interval="3000" circular indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
        <swiper-item wx:for="{{carousels}}" wx:key="id">
          <view class="carousel-item" bindtap="onCarouselTap" data-url="{{item.linkUrl || item.link}}">
            <image class="carousel-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <view class="carousel-overlay"></view>
            <view class="carousel-content">
              <view class="carousel-title">{{item.title}}</view>
              <view class="carousel-desc" wx:if="{{item.description}}">{{item.description}}</view>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <view wx:else class="fallback-hero">
        <view class="badge"><text>{{fallbackTitle.badgeText}}</text></view>
        <view class="main-title">{{fallbackTitle.mainTitle}}</view>
        <view class="sub-title">{{fallbackTitle.subTitle}}</view>
      </view>
    </view>

    <view class="publish-section" bindtap="onPublishTap">
      <view class="publish-btn">
        <text class="publish-icon">+</text>
        <text class="publish-text">{{fallbackTitle.buttonText || '发布账号'}}</text>
      </view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-container">
      <view class="filter-header">
        <image class="filter-icon" src="/images/icons/shield.svg" mode="aspectFit" />
        <text class="filter-title">筛选账号</text>
      </view>

      <view class="search-row">
        <view class="search-box">
          <text class="search-icon">搜</text>
          <input class="search-input" placeholder="输入关键字搜索账号" value="{{searchQuery}}" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" />
        </view>
      </view>

      <view class="filter-row">
        <view class="filter-item">
          <view class="filter-label">登录方式</view>
          <picker mode="selector" range="{{platformOptions}}" value="{{filters.platformIndex}}" bindchange="onPlatformChange">
            <view class="picker-box">
              <text>{{platformOptions[filters.platformIndex]}}</text>
              <text class="picker-arrow">v</text>
            </view>
          </picker>
        </view>

        <view class="filter-item">
          <view class="filter-label">段位</view>
          <picker mode="selector" range="{{rankOptions}}" value="{{filters.rankIndex}}" bindchange="onRankChange">
            <view class="picker-box">
              <text>{{rankOptions[filters.rankIndex]}}</text>
              <text class="picker-arrow">v</text>
            </view>
          </picker>
        </view>

        <view class="filter-item">
          <view class="filter-label">保险箱</view>
          <picker mode="selector" range="{{safeboxOptions}}" value="{{filters.safeboxIndex}}" bindchange="onSafeboxChange">
            <view class="picker-box">
              <text>{{safeboxOptions[filters.safeboxIndex]}}</text>
              <text class="picker-arrow">v</text>
            </view>
          </picker>
        </view>

        <view class="filter-item">
          <view class="filter-label">地区</view>
          <picker mode="selector" range="{{provinceOptions}}" value="{{filters.provinceIndex}}" bindchange="onProvinceChange">
            <view class="picker-box">
              <text>{{provinceOptions[filters.provinceIndex]}}</text>
              <text class="picker-arrow">v</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="filter-row">
        <view class="filter-item">
          <view class="filter-label">哈夫币（M）</view>
          <view class="range-box">
            <input class="range-input" type="number" placeholder="最低" value="{{filters.minCoins}}" bindinput="onMinCoinsInput" />
            <text class="range-separator">-</text>
            <input class="range-input" type="number" placeholder="最高" value="{{filters.maxCoins}}" bindinput="onMaxCoinsInput" />
          </view>
        </view>

        <view class="filter-item">
          <view class="filter-label">租金（元）</view>
          <view class="range-box">
            <input class="range-input" type="number" placeholder="最低" value="{{filters.minRental}}" bindinput="onMinRentalInput" />
            <text class="range-separator">-</text>
            <input class="range-input" type="number" placeholder="最高" value="{{filters.maxRental}}" bindinput="onMaxRentalInput" />
          </view>
        </view>
      </view>

      <view class="action-row">
        <view class="btn-toggle" bindtap="onShowMoreFilters"><text>{{showMoreFilters ? '收起皮肤筛选' : '展开皮肤筛选'}}</text></view>
        <view class="btn-reset" bindtap="onResetFilters"><text>重置</text></view>
      </view>

      <view class="skin-filter" wx:if="{{showMoreFilters}}">
        <view class="skin-header">
          <text class="skin-label">皮肤筛选（可多选）</text>
          <text class="skin-count" wx:if="{{selectedSkins.length > 0}}">已选 {{selectedSkins.length}} 项</text>
        </view>
        <view class="skin-list">
          <view class="skin-tag {{item.selected ? 'active' : ''}}" wx:for="{{skinOptionsView}}" wx:key="id" bindtap="onSkinTap" data-name="{{item.name}}">
            <text class="skin-check" wx:if="{{item.selected}}">√</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="account-section">
    <view class="account-container">
      <view class="list-header"><text class="account-count">共 {{displayAccounts.length}} 个账号</text></view>

      <view class="account-grid">
        <view class="account-card" wx:for="{{displayAccounts}}" wx:key="id" bindtap="onAccountTap" data-id="{{item.id}}">
          <view class="card-image">
            <image class="card-img" src="{{item.images[0] || '/images/default-account.png'}}" mode="aspectFill" />
            <view class="card-status {{item.status}}">{{item.statusText}}</view>
            <view class="platform-badge">{{item.login_method}}</view>
          </view>

          <view class="card-content">
            <view class="card-title">{{item.fullTitle}}</view>
            <view class="info-row">
              <view class="info-box coins">
                <text class="info-label">哈夫币</text>
                <text class="info-value">{{item.coins_display}}</text>
              </view>
              <view class="info-box ratio">
                <text class="info-label">比例</text>
                <text class="info-value">{{item.ratio_display}}</text>
              </view>
            </view>

            <view class="attributes-row">
              <view class="attribute">
                <text class="attr-label">保险箱</text>
                <text class="attr-value">{{item.safebox}}</text>
              </view>
              <view class="attribute">
                <text class="attr-label">体力/负重</text>
                <text class="attr-value">{{item.stamina_level}}/{{item.load_level}}</text>
              </view>
              <view class="attribute">
                <text class="attr-label">段位</text>
                <text class="attr-value">{{item.rank_display}}</text>
              </view>
            </view>

            <view class="kd-region-row" wx:if="{{item.kd > 0 || item.regionText}}">
              <text class="kd-text" wx:if="{{item.kd > 0}}">KD: {{item.kd}}</text>
              <text class="region-text">{{item.regionText}}</text>
            </view>

            <view class="skins-row" wx:if="{{item.tagPreview.length > 0}}">
              <text class="skin-tag" wx:for="{{item.tagPreview}}" wx:key="*this">{{item}}</text>
              <text class="skin-more" wx:if="{{item.moreTagCount > 0}}">+{{item.moreTagCount}}</text>
            </view>

            <view class="price-row">
              <view class="price-box">
                <text class="price-label">租金</text>
                <text class="price-value">¥{{item.actual_rental}}</text>
              </view>
              <view class="price-box">
                <text class="price-label">押金</text>
                <text class="price-value">¥{{item.deposit}}</text>
              </view>
              <view class="price-box">
                <text class="price-label">总价</text>
                <text class="price-value total">¥{{item.total_price}}</text>
              </view>
            </view>

            <view class="rental-duration">
              <text class="duration-label">租期</text>
              <text class="duration-value">{{item.rental_description}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{hasMore && !loading}}"><view class="btn-load-more" bindtap="onLoadMore">加载更多</view></view>

      <view class="loading" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
      </view>

      <view class="empty" wx:if="{{!loading && displayAccounts.length === 0}}">
        <view class="empty-icon">空</view>
        <view class="empty-text">暂无账号</view>
        <view class="empty-hint">调整筛选条件后再试试。</view>
      </view>
    </view>
  </view>

  <view class="tabbar-placeholder"></view>
  <customer-service-float visible="{{showCustomerService}}" bind:tap="onCustomerServiceTap" bind:close="onCustomerServiceClose" />
  <login-modal visible="{{showLoginModal}}" bind:loginSuccess="onLoginSuccess" />
</view>
