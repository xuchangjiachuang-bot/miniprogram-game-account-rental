/* pages/index/index.wxss */
.page {
  width: 100%;
  overflow-x: hidden;
  background: #ffffff;
}

.hero-section {
  width: 100%;
  background: #ffffff;
}

.hero-container {
  width: 100%;
  padding: 30rpx;
  box-sizing: border-box;
}

.carousel {
  width: 100%;
  height: 360rpx;
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  background: #111827;
}

.carousel-item,
.carousel-image {
  width: 100%;
  height: 100%;
}

.carousel-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 55%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.72), transparent);
}

.carousel-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 36rpx;
  color: #ffffff;
  z-index: 1;
  box-sizing: border-box;
}

.carousel-title {
  font-size: 34rpx;
  font-weight: 700;
}

.carousel-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.6;
}

.publish-section {
  display: flex;
  justify-content: center;
  padding: 0 30rpx 30rpx;
}

.publish-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-width: 280rpx;
  padding: 20rpx 56rpx;
  background: linear-gradient(90deg, #2563eb 0%, #9333ea 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(99, 102, 241, 0.28);
}

.publish-icon {
  font-size: 30rpx;
}

.fallback-hero {
  padding: 70rpx 40rpx 62rpx;
  text-align: center;
}

.badge {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: linear-gradient(90deg, #2563eb 0%, #9333ea 100%);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
  margin-bottom: 30rpx;
}

.main-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.3;
}

.sub-title {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}

.filter-section {
  width: 100%;
  background: #ffffff;
  padding: 30rpx 30rpx 36rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.filter-header {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.filter-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}

.filter-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.search-row {
  margin-bottom: 22rpx;
}

.search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 24rpx;
  font-size: 28rpx;
  color: #9ca3af;
}

.search-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx 0 64rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.compact-row {
  margin-bottom: 22rpx;
}

.filter-item {
  flex: 0 0 calc(50% - 10rpx);
  min-width: 0;
}

.filter-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.picker-arrow {
  font-size: 18rpx;
  color: #9ca3af;
}

.range-box {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.range-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 14rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #1f2937;
  text-align: center;
  box-sizing: border-box;
}

.range-separator {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9ca3af;
}

.action-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.btn-toggle {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  background: linear-gradient(90deg, #7c3aed 0%, #a855f7 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.btn-reset {
  width: 136rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 82rpx;
  background: #ffffff;
  color: #ef4444;
  border: 2rpx solid #fee2e2;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.skin-filter {
  padding-top: 18rpx;
  border-top: 2rpx solid #f3f4f6;
}

.skin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.skin-label {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 700;
}

.skin-count {
  font-size: 22rpx;
  color: #7c3aed;
  background: #faf5ff;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.skin-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.skin-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.skin-tag.active {
  background: #9333ea;
  border-color: #9333ea;
  color: #ffffff;
}

.skin-check {
  font-size: 20rpx;
  font-weight: 700;
}

.account-section {
  width: 100%;
  padding: 0 24rpx 30rpx;
  box-sizing: border-box;
}

.list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.account-count {
  font-size: 24rpx;
  color: #6b7280;
}

.account-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.account-card {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.card-image {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #eef2f7;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.platform-badge,
.card-status {
  position: absolute;
  top: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  backdrop-filter: blur(8rpx);
}

.platform-badge {
  left: 18rpx;
  background: rgba(147, 51, 234, 0.92);
  color: #ffffff;
}

.card-status {
  right: 18rpx;
}

.card-status.available {
  background: rgba(16, 185, 129, 0.92);
  color: #ffffff;
}

.card-status.renting,
.card-status.rented {
  background: rgba(245, 158, 11, 0.92);
  color: #ffffff;
}

.card-status.off_shelf,
.card-status.archived {
  background: rgba(100, 116, 139, 0.92);
  color: #ffffff;
}

.card-content {
  padding: 24rpx;
}

.card-top-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.5;
}

.card-region {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 22rpx;
}

.info-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.info-box {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
}

.info-box.coins {
  background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%);
}

.info-box.ratio {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
}

.info-value {
  display: block;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.attributes-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.attribute {
  text-align: center;
}

.attr-label {
  display: block;
  font-size: 20rpx;
  color: #64748b;
}

.attr-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.meta-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 700;
}

.skins-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.card-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ede9fe;
  color: #6d28d9;
  font-size: 22rpx;
  font-weight: 700;
}

.skin-more {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.price-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.price-box {
  padding: 18rpx 14rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #faf5ff;
}

.total-box {
  background: #eefbf2;
}

.price-label {
  display: block;
  font-size: 20rpx;
  color: #7c3aed;
}

.price-value {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2937;
  word-break: break-all;
}

.price-value.total {
  color: #10b981;
}

.rental-duration {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #fef3c7;
}

.duration-label {
  font-size: 22rpx;
  color: #d97706;
  font-weight: 700;
}

.duration-value {
  font-size: 24rpx;
  color: #1f2937;
  font-weight: 800;
}

.load-more {
  margin-top: 32rpx;
  text-align: center;
}

.btn-load-more {
  display: inline-block;
  padding: 18rpx 54rpx;
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 700;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #9333ea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading text {
  font-size: 24rpx;
  color: #6b7280;
}

.empty,
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 90rpx 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.05);
}

.state-card {
  border: 2rpx solid #eef2ff;
}

.state-card.error {
  border-color: #fde2e2;
  background: #fff8f8;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.45;
}

.empty-text,
.state-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.empty-hint,
.state-hint {
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
  text-align: center;
}

.state-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
}

.state-action {
  margin-top: 8rpx;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
}

.inline-error-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
}

.inline-error-action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.inline-loading {
  padding-top: 28rpx;
}

.tabbar-placeholder {
  height: 120rpx;
}
