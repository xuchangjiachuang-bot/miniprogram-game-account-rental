.page {
  width: 100%;
  overflow-x: hidden;
  background: #f8fafc;
}

.hero-section {
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.hero-container {
  padding: 18rpx 20rpx 0;
}

.carousel {
  height: 260rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #0f172a;
}

.carousel-item,
.carousel-image {
  width: 100%;
  height: 100%;
}

.carousel-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.18) 0%, rgba(15, 23, 42, 0.78) 100%);
}

.carousel-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: 22rpx 24rpx;
  color: #ffffff;
}

.hero-badge-inline,
.badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
  backdrop-filter: blur(10rpx);
}

.carousel-title,
.main-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 800;
}

.carousel-desc,
.sub-title {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  opacity: 0.92;
}

.fallback-hero {
  padding: 54rpx 28rpx 42rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
}

.publish-section {
  padding: 16rpx 20rpx 6rpx;
}

.publish-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 74rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(79, 70, 229, 0.16);
}

.publish-icon {
  font-size: 30rpx;
}

.filter-section {
  padding: 12rpx 20rpx 6rpx;
}

.filter-container {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.filter-header {
  margin-bottom: 12rpx;
}

.filter-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.filter-item {
  min-width: 0;
}

.filter-item.compact {
  flex: 0 0 calc(50% - 8rpx);
}

.filter-label {
  margin-bottom: 8rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #475569;
  font-weight: 600;
}

.range-box {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  width: 100%;
}

.picker-box,
.range-input,
.search-input {
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  color: #0f172a;
  box-sizing: border-box;
}

.compact-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
}

.region-box {
  color: #334155;
}

.picker-arrow {
  color: #94a3b8;
  font-size: 18rpx;
}

.compact-range {
  gap: 8rpx;
}

.compact-input {
  flex: 1 1 0;
  min-width: 0;
  width: 0;
  height: 66rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 20rpx;
}

.range-separator {
  color: #94a3b8;
  font-size: 20rpx;
  flex: 0 0 auto;
}

.search-action-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.search-panel {
  width: 100%;
}

.search-box {
  position: relative;
}

.compact-search-input {
  width: 100%;
  height: 68rpx;
  padding: 0 18rpx 0 52rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  font-size: 24rpx;
}

.action-panel {
  display: flex;
  gap: 12rpx;
}

.btn-toggle,
.btn-reset {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.btn-toggle {
  background: #eef2ff;
  color: #4f46e5;
}

.btn-reset {
  background: #fff7ed;
  color: #c2410c;
}

.skin-filter {
  margin-top: 6rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f1f5f9;
}

.skin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.skin-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
}

.skin-count {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
}

.skin-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.skin-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
  color: #475569;
  font-size: 20rpx;
}

.skin-tag.active {
  border-color: #6366f1;
  background: #eef2ff;
  color: #4338ca;
}

.skin-check {
  font-size: 18rpx;
  font-weight: 700;
}

.account-section {
  padding: 10rpx 20rpx 28rpx;
}

.list-header {
  margin-bottom: 16rpx;
  padding: 0 2rpx;
}

.account-count {
  font-size: 24rpx;
  color: #64748b;
}

.account-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.account-card {
  overflow: hidden;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(15, 23, 42, 0.06);
}

.card-image {
  position: relative;
  height: 270rpx;
  background: #e2e8f0;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-tag-overlay {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 120rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.overlay-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.58);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1.2;
}

.card-status {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

.card-status.available {
  background: rgba(16, 185, 129, 0.92);
}

.card-status.renting,
.card-status.rented {
  background: rgba(245, 158, 11, 0.92);
}

.card-status.off_shelf,
.card-status.archived {
  background: rgba(100, 116, 139, 0.92);
}

.card-content {
  padding: 18rpx;
}

.card-title {
  font-size: 20rpx;
  line-height: 1.45;
  color: #0f172a;
  font-weight: 700;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 58rpx;
}

.card-platform-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.platform-inline {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid #ddd6fe;
  background: #f5f3ff;
  color: #6d28d9;
  font-size: 18rpx;
  line-height: 1;
}

.card-region.plain {
  font-size: 18rpx;
  color: #64748b;
}

.metric-pair-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.metric-pair {
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
}

.metric-pair.coins {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.metric-pair.ratio {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
}

.metric-label {
  display: block;
  font-size: 18rpx;
  color: #7c2d12;
}

.metric-pair.ratio .metric-label {
  color: #6d28d9;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.attributes-row.webish-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.attribute {
  text-align: left;
}

.attr-label {
  display: block;
  font-size: 16rpx;
  color: #64748b;
}

.attr-value {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #0f172a;
}

.webish-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.meta-text {
  font-size: 18rpx;
  color: #64748b;
}

.compact-skins {
  margin-top: 12rpx;
}

.card-tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #8b5cf6 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 18rpx;
}

.skin-more {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #e2e8f0;
  color: #475569;
  font-size: 18rpx;
}

.summary-footer {
  display: grid;
  grid-template-columns: 1.25fr 0.8fr 0.95fr;
  gap: 10rpx;
  align-items: end;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #eef2f7;
}

.summary-label {
  display: block;
  font-size: 16rpx;
  color: #64748b;
}

.summary-value,
.summary-total-value {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #4f46e5;
}

.summary-duration {
  text-align: center;
}

.summary-total {
  text-align: right;
}

.summary-total-value {
  font-size: 26rpx;
  color: #16a34a;
}

.card-action-row {
  margin-top: 10rpx;
}

.detail-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.detail-arrow {
  font-size: 22rpx;
}

.load-more {
  margin-top: 28rpx;
  text-align: center;
}

.btn-load-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e2e8f0;
  background: #ffffff;
  color: #4338ca;
  font-size: 24rpx;
  font-weight: 700;
}

.loading,
.empty,
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 72rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.state-card.error {
  background: #fff7f7;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-title,
.empty-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.state-hint,
.empty-hint,
.loading text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
  text-align: center;
}

.state-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  text-align: center;
  font-size: 36rpx;
}

.state-action {
  margin-top: 6rpx;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
}

.inline-error-text,
.inline-error-action {
  font-size: 22rpx;
}

.empty-icon {
  font-size: 72rpx;
  color: #cbd5e1;
}

.inline-loading {
  padding-top: 24rpx;
}

.tabbar-placeholder {
  height: 120rpx;
}
