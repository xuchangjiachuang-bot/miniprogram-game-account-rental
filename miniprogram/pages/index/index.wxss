.page {
  width: 100%;
  overflow-x: hidden;
  background: #f5f5f5;
}

.hero-section {
  background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(255,255,255,0.92) 100%);
  border-bottom: 1rpx solid #ececec;
}

.hero-inner {
  padding: 34rpx 30rpx 36rpx;
  text-align: center;
  background-image: linear-gradient(rgba(118, 118, 255, 0.06) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(118, 118, 255, 0.06) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}

.hero-title {
  font-size: 56rpx;
  line-height: 1.24;
  font-weight: 800;
  color: #111827;
}

.hero-highlight {
  color: #5b5cf0;
}

.hero-subtitle {
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #5b6472;
}

.hero-action {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.publish-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 232rpx;
  height: 74rpx;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #3466e8 0%, #9f33f4 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.publish-icon {
  font-size: 26rpx;
}

.filter-section {
  padding: 24rpx 24rpx 10rpx;
}

.filter-header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.filter-shield {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #f2e8ff;
  color: #7c3aed;
  font-size: 18rpx;
  font-weight: 700;
}

.filter-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.filter-panel {
  padding: 20rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.field-block {
  margin-bottom: 18rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #0f172a;
  font-weight: 600;
}

.select-box,
.range-input,
.search-input {
  background: #ffffff;
  border: 2rpx solid #e5e7eb;
  color: #111827;
  box-sizing: border-box;
}

.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.region-select {
  justify-content: space-between;
}

.picker-arrow {
  color: #b4b8bf;
  font-size: 18rpx;
}

.range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.range-input {
  flex: 1 1 0;
  min-width: 0;
  width: 0;
  height: 72rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  text-align: left;
  font-size: 24rpx;
}

.range-separator {
  flex: 0 0 auto;
  color: #9aa0aa;
  font-size: 24rpx;
}

.search-box {
  position: relative;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #9aa0aa;
  font-size: 24rpx;
}

.search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx 0 54rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 8rpx;
}

.btn-toggle,
.btn-reset {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-toggle {
  background: #edf2ff;
  color: #5b5cf0;
}

.btn-reset {
  background: #fff4e8;
  color: #d97706;
}

.skin-filter {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f1f5f9;
}

.skin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.skin-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
}

.skin-count {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 20rpx;
}

.skin-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.skin-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e5e7eb;
  background: #ffffff;
  color: #475569;
  font-size: 20rpx;
}

.skin-tag.active {
  border-color: #8b5cf6;
  background: #f3e8ff;
  color: #7c3aed;
}

.skin-check {
  font-size: 18rpx;
  font-weight: 700;
}

.account-section {
  padding: 6rpx 24rpx 28rpx;
}

.list-header {
  margin-bottom: 16rpx;
  padding: 0 2rpx;
}

.account-count {
  font-size: 24rpx;
  color: #64748b;
}

.account-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.account-card {
  overflow: hidden;
  border-radius: 22rpx;
  background: #ffffff;
  border: 2rpx solid #ebebeb;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.04);
}

.card-image {
  position: relative;
  height: 300rpx;
  background: #e8ebf3;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-tag-overlay {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  right: 110rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.overlay-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.84);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 1.2;
}

.card-status {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
}

.card-status.available {
  background: #22c55e;
}

.card-status.renting,
.card-status.rented {
  background: #f59e0b;
}

.card-status.off_shelf,
.card-status.archived {
  background: #94a3b8;
}

.card-content {
  padding: 18rpx 20rpx 20rpx;
}

.card-title {
  font-size: 18rpx;
  line-height: 1.55;
  color: #111827;
  font-weight: 700;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-platform-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.platform-inline {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #8b5cf6;
  font-size: 18rpx;
}

.card-region.plain {
  font-size: 18rpx;
  color: #6b7280;
}

.metric-pair-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.metric-pair {
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
}

.metric-pair.coins {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 2rpx solid #fed7aa;
}

.metric-pair.ratio {
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
  border: 2rpx solid #ddd6fe;
}

.metric-label {
  display: block;
  font-size: 18rpx;
  color: #f97316;
}

.metric-pair.ratio .metric-label {
  color: #9333ea;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #111827;
}

.attributes-row.webish-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 14rpx;
}

.attribute {
  text-align: left;
}

.attr-label {
  display: block;
  font-size: 16rpx;
  color: #6b7280;
}

.attr-value {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #111827;
}

.webish-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.meta-text {
  font-size: 18rpx;
  color: #6b7280;
}

.compact-skins {
  margin-top: 12rpx;
}

.card-tag {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #7c3aed 0%, #9333ea 100%);
  color: #ffffff;
  font-size: 18rpx;
}

.skin-more {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: #e5e7eb;
  color: #4b5563;
  font-size: 18rpx;
}

.summary-footer {
  display: grid;
  grid-template-columns: 1.3fr 0.8fr 0.9fr;
  gap: 10rpx;
  align-items: end;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #ededed;
}

.summary-label {
  display: block;
  font-size: 16rpx;
  color: #6b7280;
}

.summary-value,
.summary-total-value {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #7c3aed;
}

.summary-duration {
  text-align: center;
}

.summary-total {
  text-align: right;
}

.summary-total-value {
  font-size: 22rpx;
  color: #16a34a;
}

.card-action-row {
  margin-top: 14rpx;
}

.detail-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #3466e8 0%, #9f33f4 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-arrow {
  font-size: 22rpx;
}

.load-more {
  margin-top: 28rpx;
  text-align: center;
}

.btn-load-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e5e7eb;
  background: #ffffff;
  color: #4338ca;
  font-size: 24rpx;
  font-weight: 700;
}

.loading,
.empty,
.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 72rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.05);
}

.state-card.error {
  background: #fff7f7;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #6366f1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-title,
.empty-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.state-hint,
.empty-hint,
.loading text {
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
  text-align: center;
}

.state-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  text-align: center;
  font-size: 36rpx;
}

.state-action {
  margin-top: 6rpx;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
}

.inline-error-text,
.inline-error-action {
  font-size: 22rpx;
}

.empty-icon {
  font-size: 72rpx;
  color: #cbd5e1;
}

.inline-loading {
  padding-top: 24rpx;
}

.tabbar-placeholder {
  height: 120rpx;
}