.page {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  background: #f4f1eb;
}

.hero-section {
  padding: 96rpx 24rpx 0;
}

.hero-card {
  padding: 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #e0ecff;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 50rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #0f172a;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: #64748b;
}

.hero-action {
  margin-top: 22rpx;
}

.publish-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 232rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.publish-icon {
  font-size: 26rpx;
}

.filter-section,
.account-section {
  padding: 22rpx 24rpx 0;
}

.section-head {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.section-caption {
  font-size: 22rpx;
  color: #64748b;
}

.filter-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 28rpx rgba(15, 23, 42, 0.06);
}

.field-block {
  min-width: 0;
}

.field-block.half {
  width: calc(50% - 8rpx);
}

.field-block.full {
  width: 100%;
}

.field-label {
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #334155;
  font-weight: 700;
}

.select-box,
.range-input,
.search-input {
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 1rpx solid #dbe1ea;
  background: #fcfcfb;
  color: #0f172a;
}

.select-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
}

.picker-arrow {
  color: #94a3b8;
  font-size: 18rpx;
}

.range-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.range-input {
  flex: 1 1 0;
  min-width: 0;
  width: 0;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.range-separator {
  color: #94a3b8;
  font-size: 22rpx;
}

.search-box {
  position: relative;
}

.search-icon {
  position: absolute;
  left: 18rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #64748b;
  font-size: 22rpx;
  font-weight: 700;
}

.search-input {
  width: 100%;
  height: 72rpx;
  padding: 0 18rpx 0 50rpx;
  font-size: 24rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.btn-toggle,
.btn-reset {
  flex: 1;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-toggle {
  background: #eff6ff;
  color: #2563eb;
}

.btn-reset {
  background: #fff7ed;
  color: #c2410c;
}

.skin-filter {
  width: 100%;
  padding-top: 4rpx;
}

.skin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.skin-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
}

.skin-count {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 20rpx;
}

.skin-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.skin-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 20rpx;
}

.skin-tag.active {
  background: #0f172a;
  color: #ffffff;
}

.skin-check {
  font-size: 18rpx;
  font-weight: 700;
}

.state-card,
.empty,
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 80rpx 36rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 28rpx rgba(15, 23, 42, 0.05);
}

.state-card.error {
  background: #fffaf7;
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0f172a;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-title,
.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.state-hint,
.empty-hint,
.loading text {
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
  text-align: center;
}

.state-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  text-align: center;
  font-size: 36rpx;
}

.state-action {
  margin-top: 6rpx;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
}

.inline-error-text,
.inline-error-action {
  font-size: 22rpx;
}

.account-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.account-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(15, 23, 42, 0.06);
}

.card-image {
  position: relative;
  height: 320rpx;
  background: #dde7f4;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-status {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.8);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.card-status.available {
  background: #16a34a;
}

.card-status.renting,
.card-status.rented {
  background: #d97706;
}

.card-status.off_shelf,
.card-status.archived {
  background: #64748b;
}

.card-tag-overlay {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.overlay-tag {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #0f172a;
  font-size: 18rpx;
}

.card-content {
  padding: 20rpx 22rpx 22rpx;
}

.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.platform-inline {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 18rpx;
  font-weight: 700;
}

.card-region.plain {
  font-size: 20rpx;
  color: #64748b;
}

.card-title {
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #0f172a;
  font-weight: 700;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.metric-pair-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.metric-pair {
  padding: 16rpx;
  border-radius: 20rpx;
}

.metric-pair.coins {
  background: #fff7ed;
}

.metric-pair.ratio {
  background: #f8fafc;
}

.metric-label {
  display: block;
  font-size: 18rpx;
  color: #64748b;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.attributes-row.webish-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.attribute {
  min-width: 0;
}

.attr-label {
  display: block;
  font-size: 16rpx;
  color: #64748b;
}

.attr-value {
  display: block;
  margin-top: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
  color: #0f172a;
}

.webish-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 12rpx;
}

.meta-text {
  font-size: 20rpx;
  color: #64748b;
}

.compact-skins {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.card-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 18rpx;
}

.skin-more {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #334155;
  font-size: 18rpx;
}

.summary-footer {
  display: grid;
  grid-template-columns: 1.25fr 0.85fr 0.9fr;
  gap: 12rpx;
  align-items: end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f7;
}

.summary-label {
  display: block;
  font-size: 16rpx;
  color: #64748b;
}

.summary-value,
.summary-total-value {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #0f172a;
}

.summary-duration {
  text-align: center;
}

.summary-total {
  text-align: right;
}

.summary-total-value {
  color: #16a34a;
}

.card-action-row {
  margin-top: 16rpx;
}

.detail-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 66rpx;
  border-radius: 18rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-arrow {
  font-size: 22rpx;
}

.load-more {
  margin-top: 28rpx;
  text-align: center;
}

.btn-load-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 20rpx rgba(15, 23, 42, 0.05);
}

.empty-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 32rpx;
  background: #f8fafc;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 800;
}

.inline-loading {
  padding-top: 24rpx;
}

.tabbar-placeholder {
  height: 120rpx;
}
