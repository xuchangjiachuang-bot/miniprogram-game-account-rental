page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.status-header {
  padding: 38rpx 28rpx 56rpx;
  color: #ffffff;
}

.status-header.status-pending {
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
}

.status-header.status-active {
  background: linear-gradient(135deg, #2563eb 0%, #4f46e5 100%);
}

.status-header.status-pending_verification {
  background: linear-gradient(135deg, #0f766e 0%, #0ea5a4 100%);
}

.status-header.status-completed {
  background: linear-gradient(135deg, #059669 0%, #10b981 100%);
}

.status-header.status-cancelled,
.status-header.status-refunded {
  background: linear-gradient(135deg, #64748b 0%, #94a3b8 100%);
}

.status-header.status-dispute {
  background: linear-gradient(135deg, #dc2626 0%, #f97316 100%);
}

.status-chip {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 22rpx;
}

.status-main {
  margin-top: 26rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
}

.status-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.status-copy {
  flex: 1;
}

.status-text {
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
}

.status-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.section-card {
  margin: -24rpx 20rpx 20rpx;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
}

.section-card + .section-card {
  margin-top: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.account-card {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.account-image {
  width: 132rpx;
  height: 132rpx;
  border-radius: 24rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-title {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 700;
  color: #0f172a;
}

.account-summary,
.account-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.summary-item,
.account-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.summary-item {
  background: #eef2ff;
  color: #4338ca;
}

.account-tag {
  background: #f1f5f9;
  color: #475569;
}

.account-arrow {
  font-size: 30rpx;
  color: #94a3b8;
}

.info-list {
  margin-top: 24rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
}

.info-item + .info-item {
  border-top: 1rpx solid #eef2f7;
}

.info-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #64748b;
}

.info-value-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  line-height: 1.7;
  color: #0f172a;
  word-break: break-all;
}

.info-value.highlight {
  font-size: 34rpx;
  font-weight: 700;
  color: #4f46e5;
}

.info-value.mono {
  font-family: 'Courier New', monospace;
  letter-spacing: 2rpx;
}

.copy-btn {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 600;
}

.copy-btn.danger {
  background: #fee2e2;
  color: #dc2626;
}

.secure-note {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 24rpx;
  line-height: 1.6;
}

.secure-list {
  margin-top: 18rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -14rpx 34rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(16rpx);
}

.btn-action {
  flex: 1;
  height: 94rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-action::after {
  border: none;
}

.btn-action.primary {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
}

.btn-action.danger {
  background: #ef4444;
  color: #ffffff;
}

.btn-action.outline {
  background: #ffffff;
  color: #0f172a;
  border: 1rpx solid #dbe3ef;
}
