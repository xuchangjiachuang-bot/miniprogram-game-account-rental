<!-- pages/order/list/index.wxml -->
<view class="page">
  <view class="tabs">
    <view
      class="tab-item {{currentTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="onTabChange"
      data-tab="{{item.key}}"
    >
      <text class="tab-name">{{item.name}}</text>
      <view class="tab-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
    </view>
  </view>

  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="onOrderTap" data-id="{{item.id}}">
      <view class="order-header">
        <view class="order-number">订单号 {{item.order_number}}</view>
        <view class="order-status" style="color: {{item.statusColor}}">
          <text class="status-dot" style="background: {{item.statusColor}}"></text>
          <text class="status-text">{{item.statusText}}</text>
        </view>
      </view>

      <view class="order-body">
        <view class="account-info">
          <image class="account-image" src="{{item.account.image}}" mode="aspectFill" />
          <view class="account-details">
            <view class="account-name">{{item.account.name}}</view>
            <view class="account-metas">
              <text class="meta-tag">哈夫币 {{item.account.coins}}</text>
              <text class="meta-tag">{{item.account.safebox}}</text>
              <text class="meta-tag">{{item.account.stamina}}</text>
            </view>
          </view>
        </view>

        <view class="price-info">
          <view class="price-item">
            <text class="price-label">租金</text>
            <text class="price-value">¥{{item.rental_price}}</text>
          </view>
          <view class="price-item">
            <text class="price-label">押金</text>
            <text class="price-value">¥{{item.deposit}}</text>
          </view>
          <view class="price-item total">
            <text class="price-label">总价</text>
            <text class="price-value">¥{{item.total_price}}</text>
          </view>
        </view>

        <view class="rental-info">
          <text class="rental-label">租期</text>
          <text class="rental-value">{{item.rental_period}}</text>
        </view>

        <view class="time-info">
          <view class="time-item">
            <text class="time-label">开始</text>
            <text class="time-value">{{item.rental_start}}</text>
          </view>
          <view class="time-item">
            <text class="time-label">结束</text>
            <text class="time-value">{{item.rental_end}}</text>
          </view>
        </view>
      </view>

      <view class="order-actions" wx:if="{{item.showActions}}">
        <button
          class="btn-action {{action.type === 'primary' ? 'primary' : action.type === 'danger' ? 'danger' : 'outline'}}"
          wx:for="{{item.actions}}"
          wx:for-item="action"
          wx:key="key"
          bindtap="onActionTap"
          data-action="{{action.key}}"
          data-id="{{item.id}}"
          catchtap="true"
        >
          {{action.text}}
        </button>
      </view>
    </view>

    <view class="loading-wrapper" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <view class="empty-state" wx:if="{{!loading && orders.length === 0}}">
      <view class="empty-icon">空</view>
      <view class="empty-title">暂无订单</view>
      <view class="empty-hint" wx:if="{{currentTab === 'all'}}">去首页租一个账号吧。</view>
      <button class="btn-go-home" bindtap="onGoHome" wx:if="{{currentTab === 'all'}}">去首页</button>
    </view>
  </view>

  <view class="tabbar-placeholder"></view>
</view>
