page {
  min-height: 100vh;
  background: #f4f1eb;
}

.page {
  padding: 96rpx 24rpx 120rpx;
  box-sizing: border-box;
}

.page-head {
  margin-bottom: 18rpx;
}

.page-eyebrow {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  color: #475569;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 16rpx;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 800;
  color: #0f172a;
}

.page-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.tabs-shell {
  position: sticky;
  top: 0;
  z-index: 10;
  margin-bottom: 18rpx;
  padding: 8rpx 0 4rpx;
  background: linear-gradient(180deg, rgba(244, 241, 235, 0.96) 0%, rgba(244, 241, 235, 0.88) 100%);
  backdrop-filter: blur(14rpx);
}

.tabs {
  white-space: nowrap;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 68rpx;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #64748b;
  font-size: 24rpx;
}

.tab-item.active {
  background: #0f172a;
  color: #ffffff;
}

.tab-name {
  font-size: 24rpx;
  font-weight: 700;
}

.tab-badge {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.order-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 30rpx rgba(15, 23, 42, 0.06);
  overflow: hidden;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx 18rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.order-number {
  font-size: 22rpx;
  color: #64748b;
}

.order-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.order-body {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 24rpx 24rpx;
}

.account-image {
  width: 152rpx;
  height: 152rpx;
  border-radius: 22rpx;
  background: #e2e8f0;
  flex-shrink: 0;
}

.account-content {
  flex: 1;
  min-width: 0;
}

.account-name {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #0f172a;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.meta-tag {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 20rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.metric-item {
  padding: 14rpx 12rpx;
  border-radius: 18rpx;
  background: #f8fafc;
}

.metric-item.total {
  background: #ecfdf5;
}

.metric-label {
  display: block;
  font-size: 18rpx;
  color: #64748b;
}

.metric-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #0f172a;
}

.timeline {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #eef2f7;
}

.timeline-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.timeline-row + .timeline-row {
  margin-top: 10rpx;
}

.timeline-label {
  font-size: 22rpx;
  color: #64748b;
}

.timeline-value {
  max-width: 64%;
  text-align: right;
  font-size: 22rpx;
  color: #0f172a;
  font-weight: 600;
}

.order-actions {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 24rpx;
}

.btn-action {
  flex: 1;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-action::after {
  border: none;
}

.btn-action.outline {
  background: #ffffff;
  color: #334155;
  border: 1rpx solid #cbd5e1;
}

.btn-action.primary {
  background: #0f172a;
  color: #ffffff;
}

.btn-action.danger {
  background: #ef4444;
  color: #ffffff;
}

.loading-wrapper,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 36rpx;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 28rpx rgba(15, 23, 42, 0.05);
}

.loading-spinner {
  width: 52rpx;
  height: 52rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #0f172a;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 24rpx;
  color: #64748b;
}

.empty-badge {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: #f8fafc;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 800;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.empty-hint {
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
  text-align: center;
}

.btn-go-home {
  min-width: 220rpx;
  height: 74rpx;
  margin: 8rpx 0 0;
  padding: 0 28rpx;
  border-radius: 18rpx;
  background: #0f172a;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-go-home::after {
  border: none;
}

.tabbar-placeholder {
  height: 120rpx;
}
