<view class="page">
  <view class="section-card order-section">
    <view class="section-header">
      <text class="section-title">订单信息</text>
      <text class="order-status">待支付</text>
    </view>

    <view class="order-card">
      <image class="account-image" src="{{account.avatar || '/images/default-account.png'}}" mode="aspectFill" />
      <view class="account-info">
        <view class="account-title">{{account.title || '游戏账号'}}</view>
        <view class="account-detail">租期：{{order.rental_period || '-'}}</view>
      </view>
    </view>

    <view class="order-price">
      <text class="price-label">订单金额</text>
      <text class="price-value">¥{{order.totalPrice || order.total_price}}</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">支付方式</view>

    <view class="payment-list">
      <view
        class="payment-item {{item.active ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}"
        wx:for="{{paymentMethods}}"
        wx:key="key"
        bindtap="onPaymentTap"
        data-payment="{{item.key}}"
      >
        <view class="payment-mark {{item.key}}">{{item.shortLabel}}</view>
        <view class="payment-info">
          <view class="payment-name">{{item.title}}</view>
          <view class="payment-desc">{{item.desc}}</view>
        </view>
        <view class="payment-check" wx:if="{{item.active}}">已选</view>
      </view>
    </view>
  </view>

  <view class="balance-warning" wx:if="{{insufficient}}">
    <text>余额不足，还需支付 ¥{{insufficientAmount}}</text>
    <view class="btn-recharge" bindtap="onRecharge">去充值</view>
  </view>

  <view class="countdown-card">
    <text class="countdown-label">请在倒计时结束前完成支付</text>
    <text class="countdown-time">{{countdown}}</text>
  </view>

  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">实付金额</text>
      <text class="total-price">¥{{order.totalPrice || order.total_price}}</text>
    </view>
    <button class="btn-pay" bindtap="onPay" disabled="{{paying || insufficient}}">
      {{paying ? '支付中...' : '立即支付'}}
    </button>
  </view>
</view>
