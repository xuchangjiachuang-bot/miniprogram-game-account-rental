page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx 20rpx calc(150rpx + env(safe-area-inset-bottom));
}

.section-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 36rpx rgba(15, 23, 42, 0.06);
}

.section-card + .section-card {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.order-status {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 600;
}

.order-card {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.account-image {
  width: 124rpx;
  height: 124rpx;
  border-radius: 24rpx;
  background: #e2e8f0;
}

.account-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.account-title {
  font-size: 30rpx;
  line-height: 1.45;
  color: #0f172a;
  font-weight: 700;
}

.account-detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.order-price {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eef2f7;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-label {
  font-size: 26rpx;
  color: #64748b;
}

.price-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #4f46e5;
}

.payment-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.payment-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  border: 2rpx solid transparent;
}

.payment-item.active {
  border-color: #6366f1;
  background: #eef2ff;
}

.payment-item.disabled {
  opacity: 0.55;
}

.payment-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.payment-mark.balance {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
}

.payment-mark.wechat {
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
}

.payment-info {
  flex: 1;
  min-width: 0;
}

.payment-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.payment-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748b;
}

.payment-check {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #4f46e5;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.balance-warning {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.btn-recharge {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #ea580c;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.countdown-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.countdown-label {
  font-size: 24rpx;
  opacity: 0.84;
}

.countdown-time {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -14rpx 34rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(16rpx);
}

.total-info {
  flex: 1;
}

.total-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.total-price {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  color: #4f46e5;
  font-weight: 700;
}

.btn-pay {
  width: 250rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-pay::after {
  border: none;
}

.btn-pay[disabled] {
  background: #cbd5e1;
}
