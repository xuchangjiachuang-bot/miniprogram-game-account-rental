<view class="page">
  <view class="hero-card">
    <view class="hero-badge">微信支付</view>
    <view class="hero-title">确认订单后完成支付</view>
    <view class="hero-desc">{{paymentDescription}}</view>
  </view>

  <view class="card" wx:if="{{accountInfo}}">
    <view class="card-title">账号信息</view>
    <view class="account-row">
      <image class="account-image" src="{{accountInfo.image}}" mode="aspectFill"></image>
      <view class="account-copy">
        <view class="account-title">{{accountInfo.title}}</view>
        <view class="account-meta">哈夫币：{{accountInfo.coins}}</view>
        <view class="account-meta">租期：{{rentalHours || 0}} 小时</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">费用明细</view>
    <view class="info-row">
      <text class="label">租金</text>
      <text class="value">¥{{rentalPrice}}</text>
    </view>
    <view class="info-row">
      <text class="label">押金</text>
      <text class="value">¥{{deposit}}</text>
    </view>
    <view class="divider"></view>
    <view class="info-row total">
      <text class="label">合计</text>
      <text class="value highlight">¥{{totalPrice}}</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">支付方式</view>
    <view class="method-item selected">
      <view class="method-icon">微</view>
      <view class="method-copy">
        <view class="method-name">微信支付</view>
        <view class="method-desc">将调用微信官方支付能力完成扣款</view>
      </view>
      <view class="method-check">已选</view>
    </view>
  </view>

  <view class="footer">
    <view class="footer-price">
      <text class="price-label">合计</text>
      <text class="price-value">¥{{totalPrice}}</text>
    </view>
    <view class="footer-actions">
      <button class="ghost-btn" bindtap="onCancel">暂不支付</button>
      <button class="pay-btn" bindtap="onPayment" disabled="{{loading}}">{{loading ? '支付中...' : '立即支付'}}</button>
    </view>
  </view>
</view>
