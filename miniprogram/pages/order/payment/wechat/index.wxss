page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  padding: 24rpx 20rpx calc(180rpx + env(safe-area-inset-bottom));
}

.hero-card,
.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 30rpx;
}

.hero-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #64748b;
}

.card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.account-row {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.account-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #e2e8f0;
}

.account-copy {
  flex: 1;
}

.account-title {
  font-size: 29rpx;
  line-height: 1.45;
  color: #0f172a;
  font-weight: 700;
}

.account-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
}

.info-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
}

.label {
  color: #64748b;
}

.value {
  color: #0f172a;
  font-weight: 600;
}

.divider {
  margin-top: 20rpx;
  height: 1rpx;
  background: #eef2f7;
}

.total .label,
.total .value {
  font-size: 32rpx;
  font-weight: 700;
}

.highlight {
  color: #16a34a;
}

.method-item {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f0fdf4;
  border: 2rpx solid #86efac;
}

.method-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.method-copy {
  flex: 1;
}

.method-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.method-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.method-check {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #16a34a;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -14rpx 34rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(16rpx);
}

.footer-price {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price-label {
  font-size: 24rpx;
  color: #64748b;
}

.price-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #16a34a;
}

.footer-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.ghost-btn,
.pay-btn {
  flex: 1;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.ghost-btn::after,
.pay-btn::after {
  border: none;
}

.ghost-btn {
  background: #f8fafc;
  color: #0f172a;
  border: 1rpx solid #dbe3ef;
}

.pay-btn {
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
  color: #ffffff;
}

.pay-btn[disabled] {
  background: #cbd5e1;
}
