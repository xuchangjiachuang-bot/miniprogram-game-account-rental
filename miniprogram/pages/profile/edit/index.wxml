<view class="page">
  <view class="hero-card">
    <view class="hero-badge">编辑资料</view>
    <view class="avatar-wrap" bindtap="onAvatarTap">
      <image class="avatar-image" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="avatar-tip">点击更换头像</view>
    </view>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入昵称"
        value="{{form.nickname}}"
        bindinput="onNicknameInput"
        maxlength="20"
      />
    </view>

    <view class="form-item">
      <text class="form-label">性别</text>
      <picker mode="selector" range="{{genderOptions}}" range-key="label" value="{{form.genderIndex}}" bindchange="onGenderChange">
        <view class="picker-value">
          <text>{{genderOptions[form.genderIndex].label}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="picker-value">
        <text>{{userInfo.phone || '未绑定手机号'}}</text>
        <text class="bind-link" bindtap="onBindPhone">{{userInfo.phone ? '修改绑定' : '去绑定'}}</text>
      </view>
    </view>

    <view class="form-item textarea-item">
      <text class="form-label">个性签名</text>
      <textarea
        class="form-textarea"
        placeholder="介绍一下自己，方便卖家和平台识别你的需求"
        value="{{form.bio}}"
        bindinput="onBioInput"
        maxlength="100"
        auto-height
      />
      <view class="char-count">{{form.bio.length}}/100</view>
    </view>
  </view>

  <view class="action-section">
    <button class="btn-save" bindtap="onSave" disabled="{{saving}}">
      {{saving ? '保存中...' : '保存资料'}}
    </button>
  </view>
</view>
