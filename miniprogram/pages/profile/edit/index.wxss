page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  padding: 24rpx 20rpx 40rpx;
}

.hero-card,
.form-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.hero-card {
  padding: 30rpx;
  text-align: center;
}

.hero-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.avatar-wrap {
  margin-top: 24rpx;
}

.avatar-image {
  width: 168rpx;
  height: 168rpx;
  border-radius: 40rpx;
  background: #e2e8f0;
}

.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.form-card {
  margin-top: 20rpx;
  padding: 0 28rpx;
}

.form-item {
  padding: 28rpx 0;
}

.form-item + .form-item {
  border-top: 1rpx solid #eef2f7;
}

.form-label {
  display: block;
  margin-bottom: 18rpx;
  font-size: 27rpx;
  color: #0f172a;
  font-weight: 700;
}

.form-input,
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #0f172a;
  line-height: 1.6;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.picker-arrow {
  color: #94a3b8;
}

.bind-link {
  color: #4f46e5;
  font-size: 24rpx;
  font-weight: 700;
}

.textarea-item {
  padding-bottom: 24rpx;
}

.form-textarea {
  min-height: 150rpx;
}

.char-count {
  margin-top: 12rpx;
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
}

.action-section {
  margin-top: 24rpx;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-save::after {
  border: none;
}

.btn-save[disabled] {
  background: #cbd5e1;
}
