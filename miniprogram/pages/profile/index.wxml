<view class="page">
  <view class="inline-error" wx:if="{{errorText}}">
    <text class="inline-error-text">{{errorText}}</text>
    <text class="inline-error-action" bindtap="onRetry">重试</text>
  </view>

  <view class="profile-shell">
    <view class="profile-top">
      <view class="profile-eyebrow">账户中心</view>
      <view class="profile-title">我的</view>
      <view class="profile-subtitle">查看交易、资产与账号状态</view>
    </view>

    <view class="identity-panel">
      <view class="identity-main" bindtap="onEditProfile">
        <image class="user-avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="user-copy">
          <view class="user-name-row">
            <text class="user-name">{{userInfo.nickname || '未设置昵称'}}</text>
            <text class="verify-pill {{userInfo.isVerified ? 'verified' : 'pending'}}">{{userInfo.verifyText}}</text>
          </view>
          <view class="user-id">{{memberText}}</view>
          <view class="user-tags" wx:if="{{userInfo.tags && userInfo.tags.length > 0}}">
            <text class="user-tag" wx:for="{{userInfo.tags}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
        <text class="user-arrow">></text>
      </view>

      <view class="stat-strip">
        <view class="stat-item" wx:for="{{statCards}}" wx:key="key" bindtap="onStatTap" data-action="{{item.action}}">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-card" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <text class="loading-text">正在刷新个人数据...</text>
  </view>

  <view class="auth-section" wx:if="{{!userInfo.isVerified}}">
    <view class="auth-mark">实名</view>
    <view class="auth-copy">
      <view class="auth-title">完成实名认证后可开启更多交易和提现能力</view>
      <view class="auth-desc">当前只需填写姓名、身份证号和手机号即可完成认证。</view>
    </view>
    <button class="btn-auth" bindtap="onVerifyTap">去认证</button>
  </view>

  <view class="menu-wrap">
    <view class="menu-group" wx:for="{{menuSections}}" wx:key="key" wx:for-item="group">
      <view
        class="menu-item {{item.danger ? 'danger' : ''}}"
        wx:for="{{group.items}}"
        wx:key="action"
        wx:for-item="item"
        bindtap="onMenuTap"
        data-action="{{item.action}}"
      >
        <view class="menu-mark {{item.danger ? 'danger' : ''}}">{{item.shortLabel}}</view>
        <view class="menu-copy">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <text class="menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <login-modal
    visible="{{showLoginModal}}"
    bind:loginSuccess="onLoginSuccess"
    bind:close="onLoginModalClose"
  />
</view>
