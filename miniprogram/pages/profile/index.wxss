page {
  min-height: 100vh;
  background: #f4f1eb;
}

.page {
  padding: 0 0 calc(32rpx + env(safe-area-inset-bottom));
}

.profile-shell {
  padding: 96rpx 24rpx 0;
}

.profile-top {
  margin-bottom: 18rpx;
}

.profile-eyebrow {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.06);
  color: #475569;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.profile-title {
  margin-top: 18rpx;
  font-size: 60rpx;
  line-height: 1;
  font-weight: 800;
  color: #0f172a;
}

.profile-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.identity-panel {
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(15, 23, 42, 0.08);
}

.identity-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
  flex-shrink: 0;
}

.user-copy {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.user-name {
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #0f172a;
}

.verify-pill {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  line-height: 42rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.verify-pill.verified {
  background: #dcfce7;
  color: #166534;
}

.verify-pill.pending {
  background: #fff1f2;
  color: #be123c;
}

.user-id {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
  word-break: break-all;
}

.user-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.user-tag {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 20rpx;
}

.user-arrow {
  color: #94a3b8;
  font-size: 30rpx;
}

.stat-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1rpx solid #e2e8f0;
  background: #fcfcfb;
}

.stat-item {
  padding: 20rpx 10rpx 22rpx;
  text-align: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid #eef2f7;
}

.stat-value {
  display: block;
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #0f172a;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #64748b;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 96rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff7ed;
  color: #c2410c;
}

.inline-error-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
}

.inline-error-action {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
}

.loading-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 18rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.05);
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2563eb;
  box-shadow: 26rpx 0 0 rgba(37, 99, 235, 0.26), -26rpx 0 0 rgba(37, 99, 235, 0.26);
}

.loading-text {
  font-size: 24rpx;
  color: #64748b;
}

.auth-section {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 18rpx 24rpx 0;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #fffaf2;
  border: 1rpx solid #fed7aa;
}

.auth-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #ffedd5;
  color: #c2410c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.auth-copy {
  flex: 1;
  min-width: 0;
}

.auth-title {
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
  color: #9a3412;
}

.auth-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #c2410c;
}

.btn-auth {
  flex-shrink: 0;
  min-width: 152rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #ea580c;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.btn-auth::after {
  border: none;
}

.menu-wrap {
  padding: 18rpx 24rpx 0;
}

.menu-group {
  margin-top: 16rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.05);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #eef2f7;
}

.menu-mark {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.menu-mark.danger {
  background: #fee2e2;
  color: #dc2626;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.menu-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.menu-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 38rpx;
  text-align: center;
}

.menu-arrow {
  color: #94a3b8;
  font-size: 28rpx;
}

.menu-item.danger .menu-title,
.menu-item.danger .menu-desc,
.menu-item.danger .menu-arrow {
  color: #dc2626;
}
