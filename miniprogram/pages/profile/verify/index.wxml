<view class="page">
  <view class="status-shell">
    <view class="status-card status-{{statusKey}}">
      <view class="status-badge">{{statusIcon}}</view>
      <view class="status-copy">
        <view class="status-text">{{statusText}}</view>
        <view class="status-desc">{{statusDesc}}</view>
      </view>
    </view>
  </view>

  <form bindsubmit="onSubmit" wx:if="{{canSubmit}}">
    <view class="section-card form-card">
      <view class="section-head">
        <view class="section-title">实名认证</view>
        <view class="section-subtitle">当前仅需填写姓名、身份证号和手机号。</view>
      </view>

      <view class="field-group">
        <view class="field-label required">真实姓名</view>
        <input
          class="form-input"
          placeholder="请输入真实姓名"
          value="{{form.realName}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="field-group">
        <view class="field-label required">身份证号</view>
        <input
          class="form-input"
          placeholder="请输入身份证号"
          value="{{form.idCard}}"
          bindinput="onIdCardInput"
          maxlength="18"
        />
      </view>

      <view class="field-group">
        <view class="field-label required">手机号</view>
        <input
          class="form-input"
          type="number"
          placeholder="请输入手机号"
          value="{{form.phone}}"
          bindinput="onPhoneInput"
          maxlength="11"
        />
      </view>
    </view>

    <view class="tips-card">
      <view class="tip-item">• 实名认证仅需提交姓名、身份证号和手机号。</view>
      <view class="tip-item">• 身份证照片上传已隐藏，前端不再展示上传入口。</view>
      <view class="tip-item">• 信息提交后会进入审核流程，请务必保证真实有效。</view>
      <view class="tip-item">• 建议使用本人常用手机号，便于后续联系与风控核验。</view>
    </view>

    <view class="submit-bar">
      <button class="btn-submit" form-type="submit" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '提交认证'}}
      </button>
    </view>
  </form>

  <view class="section-card info-card" wx:if="{{!canSubmit && userInfo.realName}}">
    <view class="section-title">认证信息</view>

    <view class="info-row">
      <text class="info-label">真实姓名</text>
      <text class="info-value">{{userInfo.realName}}</text>
    </view>

    <view class="info-row">
      <text class="info-label">身份证号</text>
      <text class="info-value">{{maskedIdCard}}</text>
    </view>

    <view class="info-row" wx:if="{{userInfo.phone}}">
      <text class="info-label">手机号</text>
      <text class="info-value">{{userInfo.phone}}</text>
    </view>

    <view class="info-row" wx:if="{{userInfo.verifiedAt}}">
      <text class="info-label">认证时间</text>
      <text class="info-value">{{userInfo.verifiedAt}}</text>
    </view>
  </view>

  <view class="history-section" wx:if="{{history.length > 0}}">
    <view class="history-title">历史记录</view>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="id" bindtap="onHistoryItemTap" data-id="{{item.id}}">
        <view class="history-left">
          <text class="history-status {{item.status}}">{{item.statusText || item.status}}</text>
          <text class="history-time">{{item.createdAt || item.created_at || '-'}}</text>
        </view>
        <text class="history-arrow">></text>
      </view>
    </view>
  </view>
</view>
