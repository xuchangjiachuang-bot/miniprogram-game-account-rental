page {
  min-height: 100vh;
  background: #f8fafc;
}

.page {
  padding: 96rpx 24rpx calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.status-shell {
  margin-bottom: 20rpx;
}

.status-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 28rpx rgba(15, 23, 42, 0.06);
}

.status-none {
  border: 2rpx solid #e5e7eb;
}

.status-pending {
  border: 2rpx solid #bfdbfe;
  background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
}

.status-approved {
  border: 2rpx solid #bbf7d0;
  background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%);
}

.status-rejected {
  border: 2rpx solid #fecaca;
  background: linear-gradient(135deg, #fff1f2 0%, #ffffff 100%);
}

.status-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
  color: #111827;
  background: #f3f4f6;
  flex-shrink: 0;
}

.status-pending .status-badge {
  background: #dbeafe;
  color: #2563eb;
}

.status-approved .status-badge {
  background: #dcfce7;
  color: #16a34a;
}

.status-rejected .status-badge {
  background: #fee2e2;
  color: #dc2626;
}

.status-copy {
  flex: 1;
}

.status-text {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #111827;
}

.status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.section-card,
.tips-card,
.history-item {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.05);
}

.section-card {
  padding: 28rpx 24rpx;
}

.form-card {
  margin-bottom: 20rpx;
}

.section-head {
  margin-bottom: 20rpx;
}

.section-title,
.history-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.section-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #64748b;
}

.field-group {
  margin-bottom: 22rpx;
}

.field-group:last-child {
  margin-bottom: 0;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.field-label.required::before {
  content: '*';
  margin-right: 8rpx;
  color: #ef4444;
}

.form-input {
  width: 100%;
  height: 82rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  border: 2rpx solid #e5e7eb;
  background: #ffffff;
  color: #111827;
  font-size: 26rpx;
}

.tips-card {
  padding: 24rpx;
}

.tip-item {
  font-size: 24rpx;
  line-height: 1.8;
  color: #334155;
}

.tip-item + .tip-item {
  margin-top: 8rpx;
}

.info-card {
  margin-top: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 24rpx;
  color: #64748b;
}

.info-value {
  max-width: 60%;
  text-align: right;
  font-size: 24rpx;
  line-height: 1.5;
  color: #111827;
  font-weight: 600;
  word-break: break-all;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
  border-radius: 22rpx;
  background: linear-gradient(90deg, #2563eb 0%, #7c3aed 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  background: #cbd5e1;
  color: #ffffff;
}

.history-section {
  margin-top: 20rpx;
}

.history-title {
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}

.history-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-status {
  font-size: 24rpx;
  font-weight: 700;
}

.history-status.pending {
  color: #2563eb;
}

.history-status.approved {
  color: #16a34a;
}

.history-status.rejected {
  color: #dc2626;
}

.history-time {
  font-size: 22rpx;
  color: #64748b;
}

.history-arrow {
  font-size: 26rpx;
  color: #94a3b8;
}
