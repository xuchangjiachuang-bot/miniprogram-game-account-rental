<view class="page">
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-title">加载中...</text>
    <text class="loading-text">正在整理本月账单数据，请稍候。</text>
  </view>

  <view class="error-state" wx:elif="{{errorText}}">
    <text class="error-title">账单暂时无法加载</text>
    <text class="error-text">{{errorText}}</text>
    <button class="error-btn" bindtap="onRetry">重新加载</button>
  </view>

  <block wx:else>
  <view class="month-selector">
    <picker mode="selector" range="{{monthList}}" range-key="label" value="{{selectedMonthIndex}}" bindchange="onMonthChange">
      <view class="selector-box">
        <text class="selector-label">账单月份</text>
        <view class="selector-main">
          <text class="selector-text">{{selectedMonthLabel}}</text>
          <text class="selector-arrow">></text>
        </view>
      </view>
    </picker>
  </view>

  <view class="bill-summary" wx:if="{{bill}}">
    <view class="summary-card">
      <view class="summary-head">
        <view class="summary-title">{{selectedMonthLabel}}</view>
        <view class="summary-count">共 {{bill.summary.transactionCount}} 笔交易</view>
      </view>
      <view class="summary-row">
        <view class="summary-col">
          <text class="summary-label">总收入</text>
          <text class="summary-value income">¥{{bill.summary.totalIncome}}</text>
        </view>
        <view class="summary-col">
          <text class="summary-label">总支出</text>
          <text class="summary-value expense">¥{{bill.summary.totalExpense}}</text>
        </view>
      </view>
      <view class="summary-net">
        <text class="net-label">净收入</text>
        <text class="net-value {{bill.summary.netIncomeValue >= 0 ? 'income' : 'expense'}}">
          {{bill.summary.netIncomeValue >= 0 ? '+' : '-'}}¥{{bill.summary.netIncome}}
        </text>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{bill && bill.categoryStats.length}}">
    <view class="section-title">分类统计</view>
    <view class="category-list">
      <view class="category-item" wx:for="{{bill.categoryStats}}" wx:key="name">
        <view class="category-info">
          <text class="category-name">{{item.name}}</text>
          <text class="category-count">{{item.count}} 笔</text>
        </view>
        <text class="category-amount {{item.amountClass}}">{{item.amountText}}</text>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{bill && bill.dailyStats.length}}">
    <view class="section-title">每日收支</view>
    <view class="daily-chart">
      <view class="chart-row" wx:for="{{bill.dailyStats}}" wx:key="dateLabel">
        <text class="row-date">{{item.dateLabel}}</text>
        <view class="row-bar-wrapper">
          <view class="row-bar income" style="width: {{item.incomeWidth}}%"></view>
          <view class="row-bar expense" style="width: {{item.expenseWidth}}%"></view>
        </view>
        <view class="row-amounts">
          <text class="amount income">¥{{item.incomeDisplay}}</text>
          <text class="amount expense">¥{{item.expenseDisplay}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-card" wx:if="{{bill && bill.transactions.length}}">
    <view class="section-title">交易明细</view>
    <view class="transaction-list">
      <view class="transaction-item" wx:for="{{bill.transactions}}" wx:key="id" bindtap="onTransactionTap" data-id="{{item.id}}">
        <view class="transaction-left">
          <text class="transaction-type">{{item.transactionTypeName}}</text>
          <text class="transaction-desc">{{item.description}}</text>
          <text class="transaction-time">{{item.createdAt}}</text>
        </view>
        <text class="transaction-amount {{item.amountClass}}">{{item.amountText}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{bill && bill.transactions.length === 0}}">
    <text class="empty-title">本月暂无交易记录</text>
    <text class="empty-text">切换月份后可查看其他月份的账单数据。</text>
  </view>
  </block>
</view>
