page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  padding: 24rpx 20rpx 40rpx;
}

.loading-state,
.error-state {
  padding: 80rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.loading-title,
.error-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.loading-text,
.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}

.error-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.error-btn::after {
  border: none;
}

.month-selector,
.section-card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.month-selector {
  padding: 20rpx;
}

.selector-box {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.selector-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.selector-main {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.selector-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.selector-arrow {
  font-size: 26rpx;
  color: #94a3b8;
}

.bill-summary {
  margin-top: 20rpx;
}

.summary-card {
  padding: 32rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #312e81 0%, #4f46e5 52%, #6366f1 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 38rpx rgba(79, 70, 229, 0.2);
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-title {
  font-size: 32rpx;
  font-weight: 700;
}

.summary-count {
  font-size: 22rpx;
  opacity: 0.84;
}

.summary-row {
  margin-top: 26rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.summary-col {
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
}

.summary-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.88;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.summary-value.income {
  color: #dcfce7;
}

.summary-value.expense {
  color: #fee2e2;
}

.summary-net {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.net-label {
  font-size: 24rpx;
  opacity: 0.88;
}

.net-value {
  font-size: 34rpx;
  font-weight: 700;
}

.net-value.income {
  color: #dcfce7;
}

.net-value.expense {
  color: #fee2e2;
}

.section-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.category-list,
.transaction-list,
.daily-chart {
  margin-top: 22rpx;
}

.category-list,
.transaction-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.category-item,
.transaction-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
}

.category-info,
.transaction-left {
  flex: 1;
  min-width: 0;
}

.category-name,
.transaction-type {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 700;
}

.category-count,
.transaction-desc,
.transaction-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
}

.category-amount,
.transaction-amount {
  font-size: 30rpx;
  font-weight: 700;
}

.category-amount.income,
.transaction-amount.income,
.amount.income {
  color: #16a34a;
}

.category-amount.expense,
.transaction-amount.expense,
.amount.expense {
  color: #dc2626;
}

.chart-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
}

.chart-row + .chart-row {
  border-top: 1rpx solid #eef2f7;
}

.row-date {
  width: 86rpx;
  font-size: 22rpx;
  color: #64748b;
  text-align: right;
}

.row-bar-wrapper {
  flex: 1;
  display: flex;
  gap: 4rpx;
  height: 22rpx;
  background: #eef2f7;
  border-radius: 999rpx;
  overflow: hidden;
}

.row-bar {
  height: 100%;
  min-width: 4rpx;
  border-radius: 999rpx;
}

.row-bar.income {
  background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
}

.row-bar.expense {
  background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
}

.row-amounts {
  min-width: 132rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.amount {
  display: block;
  text-align: right;
  font-size: 20rpx;
}

.empty-state {
  margin-top: 20rpx;
  padding: 80rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.empty-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #64748b;
}
