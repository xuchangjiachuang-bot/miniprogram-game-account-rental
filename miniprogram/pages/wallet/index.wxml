<!-- pages/wallet/index.wxml -->
<view class="page">
  <view class="state-card" wx:if="{{loading && !statistics && transactions.length === 0}}">
    <view class="state-spinner"></view>
    <view class="state-title">正在加载钱包数据</view>
    <view class="state-hint">余额、统计和账单明细会一起刷新。</view>
  </view>

  <view class="state-card error" wx:elif="{{!loading && errorText && !statistics && transactions.length === 0}}">
    <view class="state-icon">!</view>
    <view class="state-title">钱包数据加载失败</view>
    <view class="state-hint">{{errorText}}</view>
    <view class="state-action" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:else>
    <view class="inline-error" wx:if="{{errorText}}">
      <text class="inline-error-text">{{errorText}}</text>
      <text class="inline-error-action" bindtap="onRetry">重试</text>
    </view>

    <view class="balance-card">
      <view class="balance-header">
        <text class="balance-title">可用余额</text>
        <text class="balance-amount">¥{{wallet.balance}}</text>
      </view>
      <view class="balance-actions">
        <view class="action-item" bindtap="onRechargeTap">
          <view class="action-icon recharge-icon"></view>
          <text class="action-text">充值</text>
        </view>
        <view class="action-item" bindtap="onWithdrawTap">
          <view class="action-icon withdraw-icon"></view>
          <text class="action-text">提现</text>
        </view>
      </view>
    </view>

    <view class="statistics-card">
      <view class="card-header">
        <text class="card-title">收支统计</text>
        <picker mode="selector" range="{{periodList}}" range-key="label" value="{{currentPeriodIndex}}" bindchange="onPeriodChange">
          <view class="period-selector">
            <text class="period-text">{{periodList[currentPeriodIndex].label}}</text>
            <text class="period-arrow">v</text>
          </view>
        </picker>
      </view>

      <view class="statistics-summary" wx:if="{{statistics}}">
        <view class="summary-item">
          <text class="summary-label">总收入</text>
          <text class="summary-value income">+¥{{statistics.summary.totalIncome}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">总支出</text>
          <text class="summary-value expense">-¥{{statistics.summary.totalExpense}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">净收入</text>
          <text class="summary-value {{statistics.summary.netIncomeValue >= 0 ? 'income' : 'expense'}}">
            {{statistics.summary.netIncomeValue >= 0 ? '+' : '-'}}¥{{statistics.summary.netIncome}}
          </text>
        </view>
      </view>

      <view class="chart-container" wx:if="{{statistics && statistics.dailyStats.length}}">
        <view class="chart-title">近期开销趋势</view>
        <scroll-view class="chart-scroll" scroll-x>
          <view class="chart-bars">
            <view class="chart-bar" wx:for="{{statistics.dailyStats}}" wx:key="date">
              <view class="bar-wrapper">
                <view class="bar-income" style="height: {{item.incomeHeight}}%"></view>
                <view class="bar-expense" style="height: {{item.expenseHeight}}%"></view>
              </view>
              <view class="bar-label">{{item.label}}</view>
            </view>
          </view>
        </scroll-view>
        <view class="chart-legend">
          <view class="legend-item">
            <view class="legend-color income"></view>
            <text class="legend-text">收入</text>
          </view>
          <view class="legend-item">
            <view class="legend-color expense"></view>
            <text class="legend-text">支出</text>
          </view>
        </view>
      </view>

      <view class="stats-empty" wx:if="{{statistics && statistics.dailyStats.length === 0}}">
        <text class="stats-empty-text">当前时间范围内还没有统计数据</text>
      </view>

      <view class="chart-footer" bindtap="onStatisticsTap">
        <text class="footer-text">查看明细统计 ></text>
      </view>
    </view>

    <view class="bill-entry" bindtap="onMonthlyBillTap">
      <view class="bill-icon"></view>
      <view class="bill-info">
        <text class="bill-title">月度账单</text>
        <text class="bill-desc">按月查看收入、支出与流水明细</text>
      </view>
      <text class="bill-arrow">></text>
    </view>

    <view class="transactions-card">
      <view class="card-header">
        <text class="card-title">近期交易</text>
        <text class="card-link" bindtap="onTransactionsTap">查看账单 ></text>
      </view>

      <view class="transaction-list">
        <view class="transaction-item" wx:for="{{transactions}}" wx:key="id" bindtap="onTransactionTap" data-id="{{item.id}}">
          <image class="transaction-icon" src="{{item.icon}}" mode="aspectFit"></image>
          <view class="transaction-info">
            <text class="transaction-title">{{item.title}}</text>
            <text class="transaction-time">{{item.createdAtText}}</text>
          </view>
          <text class="transaction-amount {{item.amountClass}}">{{item.amountText}}</text>
        </view>

        <view class="empty-state" wx:if="{{transactions.length === 0}}">
          <text class="empty-text">暂无交易记录</text>
        </view>
      </view>
    </view>
  </block>
</view>
