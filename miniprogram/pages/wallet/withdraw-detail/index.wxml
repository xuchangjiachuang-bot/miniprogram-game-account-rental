<view class="page">
  <view class="content" wx:if="{{withdrawal}}">
    <view class="status-card">
      <view class="status-badge">提现详情</view>
      <view class="status-icon" style="background: {{withdrawal.statusColor}}20">
        <text class="status-emoji">{{withdrawal.statusIcon}}</text>
      </view>
      <text class="status-text" style="color: {{withdrawal.statusColor}}">{{withdrawal.statusText}}</text>
      <text class="amount-text">¥{{withdrawal.actualAmountText}}</text>
    </view>

    <view class="section-card">
      <view class="section-title">处理进度</view>
      <view class="timeline">
        <block wx:for="{{withdrawal.timeline}}" wx:key="key">
          <view class="timeline-item {{item.active ? 'active' : ''}} {{item.rejected ? 'rejected' : ''}}">
            <view class="timeline-dot"></view>
            <view class="timeline-content">
              <text class="timeline-title">{{item.title}}</text>
              <text class="timeline-time">{{item.time}}</text>
            </view>
          </view>
          <view class="timeline-line" wx:if="{{index !== withdrawal.timeline.length - 1}}"></view>
        </block>
      </view>
      <view class="review-remark" wx:if="{{withdrawal.reviewRemark}}">
        <text class="remark-label">审核备注</text>
        <text class="remark-text">{{withdrawal.reviewRemark}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">提现信息</view>
      <view class="info-row">
        <text class="info-label">提现单号</text>
        <view class="info-value-wrapper">
          <text class="info-value">{{withdrawal.withdrawalNo}}</text>
          <text class="copy-btn" bindtap="onCopyNo">复制</text>
        </view>
      </view>
      <view class="info-row">
        <text class="info-label">提现方式</text>
        <text class="info-value">{{withdrawal.withdrawalTypeText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">到账账户</text>
        <text class="info-value">{{withdrawal.accountName}}（{{withdrawal.accountNumber}}）</text>
      </view>
      <view class="info-row">
        <text class="info-label">申请时间</text>
        <text class="info-value">{{withdrawal.createdAt}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">金额明细</view>
      <view class="info-row">
        <text class="info-label">提现金额</text>
        <text class="info-value">¥{{withdrawal.amountText}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">手续费</text>
        <text class="info-value">-¥{{withdrawal.feeText}}</text>
      </view>
      <view class="info-row total-row">
        <text class="info-label">实际到账</text>
        <text class="info-value highlight">¥{{withdrawal.actualAmountText}}</text>
      </view>
    </view>

    <view class="action-buttons">
      <button class="btn secondary" bindtap="onContactService">联系平台</button>
      <button class="btn primary" bindtap="onRefresh">刷新状态</button>
    </view>
  </view>

  <view class="loading" wx:if="{{!withdrawal}}">
    <text class="loading-title">加载中...</text>
    <text class="loading-text">正在获取提现详情，请稍候。</text>
  </view>
</view>
