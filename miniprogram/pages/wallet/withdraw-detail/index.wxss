page {
  min-height: 100vh;
  background: #f4f6fb;
}

.page {
  padding: 24rpx 20rpx 40rpx;
}

.status-card,
.section-card,
.loading {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.status-card {
  padding: 34rpx 30rpx;
  text-align: center;
}

.status-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 24rpx auto 18rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-emoji {
  font-size: 58rpx;
  font-weight: 700;
}

.status-text {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.amount-text {
  display: block;
  margin-top: 14rpx;
  font-size: 54rpx;
  font-weight: 700;
  color: #0f172a;
}

.section-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 18rpx;
}

.timeline-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #e2e8f0;
  border: 4rpx solid #cbd5e1;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.timeline-item.active .timeline-dot {
  background: #16a34a;
  border-color: #16a34a;
}

.timeline-item.rejected .timeline-dot {
  background: #dc2626;
  border-color: #dc2626;
}

.timeline-content {
  flex: 1;
}

.timeline-title {
  display: block;
  font-size: 27rpx;
  font-weight: 700;
  color: #0f172a;
}

.timeline-time {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #64748b;
}

.timeline-line {
  width: 2rpx;
  height: 28rpx;
  background: #e2e8f0;
  margin: 10rpx 0 10rpx 12rpx;
}

.review-remark {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff7ed;
}

.remark-label {
  display: block;
  font-size: 22rpx;
  color: #c2410c;
  font-weight: 700;
}

.remark-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #9a3412;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
}

.info-row + .info-row {
  border-top: 1rpx solid #eef2f7;
}

.info-label {
  width: 150rpx;
  font-size: 25rpx;
  color: #64748b;
}

.info-value-wrapper {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 12rpx;
}

.info-value {
  flex: 1;
  text-align: right;
  font-size: 27rpx;
  line-height: 1.7;
  color: #0f172a;
  word-break: break-all;
}

.copy-btn {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4338ca;
  font-size: 22rpx;
  font-weight: 700;
}

.total-row .info-label,
.total-row .info-value {
  font-size: 30rpx;
  font-weight: 700;
}

.highlight {
  color: #16a34a;
}

.action-buttons {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
}

.btn.secondary {
  background: #ffffff;
  color: #0f172a;
  border: 1rpx solid #dbe3ef;
}

.loading {
  margin-top: 20rpx;
  padding: 80rpx 30rpx;
  text-align: center;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(15, 23, 42, 0.06);
}

.loading-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.loading-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
}

.error-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.error-btn::after {
  border: none;
}
